import { AedstTokens } from "aedst_tokens.slint";
import { AedstLayout } from "aedst_layout.slint";

// Wraps its children (the trigger, for example a link) and shows a card with a title and a
// description under them while the pointer rests on them. Slint has one children slot, so the
// card content is text. Pointer-only: the information must also be reachable another way.
export component AedstHoverCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <duration> delay: 700ms;
    in property <length> card-width: 280px;

    private property <bool> rtl: AedstLayout.rtl;
    private property <bool> shown: false;

    min-width: content.min-width;
    min-height: content.min-height;
    preferred-width: content.preferred-width;
    preferred-height: content.preferred-height;

    // A parent TouchArea sees the hover while the children keep their own clicks.
    hover := TouchArea {
        changed has-hover => {
            if (!self.has-hover && root.shown) {
                root.shown = false;
                popup.close();
            }
        }
        content := VerticalLayout {
            @children
        }
    }

    Timer {
        interval: root.delay;
        running: hover.has-hover && !root.shown && (root.title != "" || root.description != "");
        triggered => {
            root.shown = true;
            popup.show();
        }
    }

    popup := PopupWindow {
        x: root.rtl ? root.width - root.card-width : 0px;
        y: root.height + AedstTokens.spacing-xs;
        width: root.card-width;
        close-policy: PopupClosePolicy.no-auto-close;
        Rectangle {
            background: AedstTokens.popover;
            border-radius: AedstTokens.radius-lg;
            border-width: 1px;
            border-color: AedstTokens.border;
            drop-shadow-blur: AedstTokens.elevation-level-4;
            drop-shadow-offset-y: AedstTokens.elevation-level-1;
            drop-shadow-color: AedstTokens.foreground.transparentize(0.85);
            VerticalLayout {
                padding: AedstTokens.spacing-md;
                spacing: AedstTokens.spacing-xs;
                if root.title != "": Text {
                    text: root.title;
                    color: AedstTokens.popover-foreground;
                    font-size: AedstTokens.typography-label-large-font-size;
                    font-weight: AedstTokens.typography-label-large-font-weight;
                    horizontal-alignment: root.rtl ? right : left;
                    wrap: word-wrap;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: AedstTokens.muted-foreground;
                    font-size: AedstTokens.typography-body-medium-font-size;
                    horizontal-alignment: root.rtl ? right : left;
                    wrap: word-wrap;
                }
            }
        }
    }
}
