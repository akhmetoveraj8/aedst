import { AedstTokens } from "aedst_tokens.slint";
import { AedstLayout } from "aedst_layout.slint";

// Web `size`: sm tightens the card spacing from 16px to 12px and sets the title in text-sm.
export enum AedstCardSize { default, sm }

// A bordered surface with an optional header (title, description) above its content.
export component AedstCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <AedstCardSize> size: AedstCardSize.default;

    private property <bool> rtl: AedstLayout.rtl;
    private property <length> card-spacing: root.size == AedstCardSize.sm ? AedstTokens.spacing-md : AedstTokens.spacing-lg;

    background: AedstTokens.card;
    border-radius: AedstTokens.radius-xl;
    border-width: 1px;
    border-color: AedstTokens.border;

    VerticalLayout {
        padding: root.card-spacing;
        spacing: root.card-spacing;
        if root.title != "" || root.description != "": VerticalLayout {
            spacing: AedstTokens.spacing-xs;
            if root.title != "": Text {
                text: root.title;
                color: AedstTokens.card-foreground;
                font-size: root.size == AedstCardSize.sm ? AedstTokens.typography-body-medium-font-size : AedstTokens.typography-title-small-font-size;
                font-weight: AedstTokens.typography-title-small-font-weight;
                horizontal-alignment: root.rtl ? right : left;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: AedstTokens.muted-foreground;
                font-size: AedstTokens.typography-body-medium-font-size;
                horizontal-alignment: root.rtl ? right : left;
                wrap: word-wrap;
            }
        }
        @children
    }
}
