import { AedstTokens } from "aedst_tokens.slint";

// A placeholder block shown while content loads. Set `animated: false` for reduced motion.
// `label` (for example "Loading") is announced once; leave it empty for purely decorative blocks.
export component AedstSkeleton inherits Rectangle {
    in property <bool> animated: true;
    in property <string> label;

    background: AedstTokens.muted;
    border-radius: AedstTokens.radius-md;
    min-height: AedstTokens.spacing-lg;
    opacity: root.animated ? 0.5 + 0.5 * Math.abs(Math.sin(180deg * (animation-tick() / 1s))) : 1.0;
    accessible-role: root.label == "" ? AccessibleRole.none : AccessibleRole.progress-indicator;
    accessible-label: root.label;
}
