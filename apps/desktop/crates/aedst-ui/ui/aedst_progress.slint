import { AedstTokens } from "aedst_tokens.slint";
import { AedstLayout } from "aedst_layout.slint";
import { AedstA11y } from "aedst_a11y.slint";

// A determinate progress bar. `value` runs from 0 to `maximum`; the bar fills from the reading
// start edge (the right in RTL).
export component AedstProgress inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 100;
    in property <string> label;

    private property <bool> rtl: AedstLayout.rtl;
    private property <float> fraction: root.maximum <= 0 ? 0 : Math.max(0, Math.min(1, root.value / root.maximum));

    min-height: 4px;
    max-height: 4px;
    min-width: 32px;
    horizontal-stretch: 1;
    border-radius: 2px;
    background: AedstA11y.track;
    border-width: AedstA11y.high-contrast ? 1px : 0px;
    border-color: AedstA11y.border;
    clip: true;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: "\{Math.round(root.value)}";
    accessible-value-minimum: 0;
    accessible-value-maximum: root.maximum;

    Rectangle {
        x: root.rtl ? parent.width - self.width : 0px;
        y: 0px;
        width: parent.width * root.fraction;
        height: parent.height;
        border-radius: 2px;
        background: AedstTokens.primary;
        animate width { duration: AedstA11y.motion(AedstTokens.motion-duration-normal); easing: ease-out; }
    }
}
