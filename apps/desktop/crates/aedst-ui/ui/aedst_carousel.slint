import { AedstTokens } from "aedst_tokens.slint";
import { AedstLayout } from "aedst_layout.slint";
import { AedstA11y } from "aedst_a11y.slint";
import { AedstButton, AedstButtonVariant, AedstButtonSize } from "aedst_button.slint";

// A row of slides (the children) of which one is visible. Set `count` to the number of
// children: every slide gets the full width of the carousel. Previous/next buttons, dots, and a
// tab stop where the arrow keys change the slide (Left/Right follow the reading direction).
// Slint cannot reverse the children it is given (`@children` is opaque), so the slides keep the
// order the caller declares. For a mirrored carousel in RTL (slides enter from the left, the first
// slide at the right) set `reverse-in-rtl` and declare the slides last to first: the carousel then
// shows the physically mirrored position of `current-index`, and the animation runs the other way.
// The slide change is instant when `AedstA11y.reduce-motion` is set.
export component AedstCarousel inherits Rectangle {
    in property <int> count;
    in-out property <int> current-index: 0;
    in property <string> label;
    in property <string> previous-label;
    in property <string> next-label;
    // True when the caller declares the slides in reverse order in RTL (see above).
    in property <bool> reverse-in-rtl: false;
    out property <bool> has-focus: focus.has-focus;
    callback index-changed(int);

    private property <bool> rtl: AedstLayout.rtl;
    private property <length> bar: 36px;
    // The position in the physical strip of the slide `current-index`.
    private property <int> physical: (root.reverse-in-rtl && root.rtl) ? AedstLayout.mirror(root.current-index, root.count) : root.current-index;

    function go(target: int) {
        if (target >= 0 && target < root.count && target != root.current-index) {
            root.current-index = target;
            root.index-changed(target);
        }
    }

    min-height: 96px + root.bar;
    forward-focus: focus;
    accessible-role: groupbox;
    accessible-label: root.label;
    accessible-value: "\{root.current-index + 1} / \{root.count}";

    focus := FocusScope {
        key-pressed(event) => {
            if (AedstLayout.is-forward(event.text)) {
                root.go(root.current-index + 1);
                return accept;
            }
            if (AedstLayout.is-backward(event.text)) {
                root.go(root.current-index - 1);
                return accept;
            }
            if (event.text == Key.Home) {
                root.go(0);
                return accept;
            }
            if (event.text == Key.End) {
                root.go(root.count - 1);
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height - root.bar;
            clip: true;
            border-radius: AedstTokens.radius-lg;
            border-width: focus.has-focus ? 2px : 0px;
            border-color: AedstA11y.ring;
            strip := Rectangle {
                x: -root.physical * parent.width;
                width: Math.max(1, root.count) * parent.width;
                animate x { duration: AedstA11y.motion(AedstTokens.motion-duration-slow); easing: ease-in-out; }
                HorizontalLayout {
                    @children
                }
            }
        }
    }

    HorizontalLayout {
        y: parent.height - root.bar;
        height: root.bar;
        spacing: AedstTokens.spacing-sm;
        alignment: center;
        // "Previous" sits at the reading start: the first button is "next" in RTL. The glyph points
        // to the physical left, which is the direction of "next" in RTL.
        VerticalLayout {
            alignment: center;
            AedstButton {
                text: "\u{2039}";
                label: root.rtl ? root.next-label : root.previous-label;
                variant: AedstButtonVariant.outline;
                size: AedstButtonSize.icon-sm;
                enabled: root.rtl ? root.current-index < root.count - 1 : root.current-index > 0;
                clicked => { root.go(root.current-index + (root.rtl ? 1 : -1)); }
            }
        }
        for slot in root.count: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: AedstLayout.mirror(slot, root.count) == root.current-index ? AedstTokens.foreground : AedstA11y.border;
            }
        }
        VerticalLayout {
            alignment: center;
            AedstButton {
                text: "\u{203a}";
                label: root.rtl ? root.previous-label : root.next-label;
                variant: AedstButtonVariant.outline;
                size: AedstButtonSize.icon-sm;
                enabled: root.rtl ? root.current-index > 0 : root.current-index < root.count - 1;
                clicked => { root.go(root.current-index + (root.rtl ? -1 : 1)); }
            }
        }
    }
}
