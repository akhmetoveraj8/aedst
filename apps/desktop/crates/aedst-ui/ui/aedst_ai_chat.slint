// `ListView` (std-widgets) is the only Slint element that creates rows lazily, which a long
// thread needs; the kit's third std-widgets use after AedstNativeSelect and AedstMessageScroller.
import { ListView } from "std-widgets.slint";
import { AedstTokens } from "aedst_tokens.slint";
import { AedstButton, AedstButtonVariant, AedstButtonSize } from "aedst_button.slint";
import { AedstEmpty, AedstEmptyVariant } from "aedst_empty.slint";
import { AedstAiMessage, AedstAiMessageRole, AedstAiMessageAction } from "aedst_ai_message.slint";

// One turn of the thread (web `AiChatItem` wrapping an `AiMessage`).
export struct AedstAiChatItem {
    id: string,
    from: AedstAiMessageRole,
    author: string,
    avatar: image,
    avatar-fallback: string,
    header: string,
    text: string,
    // True on the reply that is still streaming; its actions stay hidden until it ends.
    streaming: bool,
    actions: [AedstAiMessageAction],
}

// The thread of a conversation with an agent (web `AiChat`, `AiChatContent`, `AiChatItem`,
// `AiChatScrollButton`, `AiChatEmptyState`). Each row is an AedstAiMessage. The scrolling
// follows AedstMessageScroller (whose rows are fixed to AedstMessage + one AedstBubble, and Slint
// has no row templates, so the same rules are applied here to a ListView of AI turns): while the
// view is at the bottom it follows new turns and the growing streamed reply; once the user
// scrolls up it stays put and a jump-to-latest button appears. Before the first turn the empty
// state (title, description, media) shows instead. The caller owns `items` (a Rust `VecModel`).
export component AedstAiChat inherits Rectangle {
    in property <[AedstAiChatItem]> items;
    // Accessible name of the thread, for example "Conversation".
    in property <string> label;
    // True while a reply is submitted or streaming (web `aria-busy`): `busy-label` becomes the
    // accessible description of the thread and of the streaming reply.
    in property <bool> busy: false;
    in property <string> busy-label;
    // Accessible name of the jump button, for example "Scroll to latest message".
    in property <string> jump-label;
    // Follow the reply while at the live edge (web `autoScroll`).
    in property <bool> auto-scroll: true;
    in property <length> stick-threshold: 16px;
    in property <string> empty-title;
    in property <string> empty-description;
    in property <image> empty-media;
    out property <bool> at-bottom: list.content-y <= list.visible-height - list.content-height + root.stick-threshold;
    // The `id` of the turn and the `id` of its action.
    callback action(string, string);

    private property <bool> stick: true;

    public function scroll-to-end() {
        list.content-y = Math.min(0px, list.visible-height - list.content-height);
        root.stick = true;
    }

    if root.items.length == 0: AedstEmpty {
        width: root.width;
        height: root.height;
        title: root.empty-title;
        description: root.empty-description;
        media: root.empty-media;
        variant: AedstEmptyVariant.icon;
    }

    list := ListView {
        visible: root.items.length > 0;
        width: root.width;
        height: root.height;
        accessible-label: root.label;
        accessible-description: root.busy ? root.busy-label : "";

        changed content-y => { root.stick = root.at-bottom; }
        changed content-height => {
            if (root.stick && root.auto-scroll) {
                root.scroll-to-end();
            }
        }
        changed visible-height => {
            if (root.stick && root.auto-scroll) {
                root.scroll-to-end();
            }
        }

        for item in root.items: Rectangle {
            VerticalLayout {
                // Web gap-6 between turns, px-4.
                padding-left: AedstTokens.spacing-lg;
                padding-right: AedstTokens.spacing-lg;
                padding-top: AedstTokens.spacing-md;
                padding-bottom: AedstTokens.spacing-md;
                AedstAiMessage {
                    from: item.from;
                    author: item.author;
                    avatar: item.avatar;
                    avatar-fallback: item.avatar-fallback;
                    header: item.header;
                    text: item.text;
                    streaming: item.streaming;
                    busy-label: root.busy-label;
                    actions: item.actions;
                    action(id) => { root.action(item.id, id); }
                }
            }
        }
    }

    // Jump to the latest turn: bottom centre, only while scrolled away from the live edge.
    if root.items.length > 0 && !root.at-bottom: AedstButton {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - AedstTokens.spacing-lg;
        text: "\u{2193}";
        label: root.jump-label;
        variant: AedstButtonVariant.outline;
        size: AedstButtonSize.icon-sm;
        clicked => { root.scroll-to-end(); }
    }
}
