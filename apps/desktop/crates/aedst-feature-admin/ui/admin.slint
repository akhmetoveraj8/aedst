// The Admin screen. Stateless: it renders `AdminStore` and calls its callbacks; Rust
// (`ui_glue.rs`) owns the state. Only `aedst-ui` components are used.
import { AedstTokens, AedstLayout, AedstLabel, AedstButton, AedstInput, AedstButtonVariant } from "@aedst-ui";
import { ListView } from "std-widgets.slint"; // rows are created lazily only directly inside a ListView (slint-rules M1)
import { AdminStore, AdminTab, AdminPhase, AdminDeleteState } from "admin_store.slint";
import { AdminTexts } from "admin_texts.slint";
import { OverviewRow, TaskRow, AuditRow, DeleteConfirm, BroadcastForm } from "admin_parts.slint";

export { AdminStore, OverviewItemData, AdminTaskRowData, AuditRowData, AdminTab, AdminPhase, AdminDeleteState, AdminBroadcastState } from "admin_store.slint";
export { AdminTexts } from "admin_texts.slint";

component TabButton inherits AedstButton {
    in property <AdminTab> key;
    variant: AdminStore.tab == root.key ? AedstButtonVariant.default : AedstButtonVariant.secondary;
    min-width: 72px;
    clicked => { AdminStore.select-tab(root.key); }
}

component TabStrip inherits HorizontalLayout {
    spacing: AedstTokens.spacing-sm;
    alignment: AedstLayout.rtl ? end : start;
    vertical-stretch: 0;
    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        TabButton { key: AdminTab.overview; text: @tr("admin" => "Overview"); }
        TabButton { key: AdminTab.tasks; text: @tr("admin" => "Tasks"); }
        TabButton { key: AdminTab.audit; text: @tr("admin" => "Audit log"); }
        TabButton { key: AdminTab.broadcast; text: @tr("admin" => "Broadcast"); }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        TabButton { key: AdminTab.broadcast; text: @tr("admin" => "Broadcast"); }
        TabButton { key: AdminTab.audit; text: @tr("admin" => "Audit log"); }
        TabButton { key: AdminTab.tasks; text: @tr("admin" => "Tasks"); }
        TabButton { key: AdminTab.overview; text: @tr("admin" => "Overview"); }
    }
}

component OwnerFilter inherits HorizontalLayout {
    spacing: AedstTokens.spacing-sm;
    vertical-stretch: 0;
    field := AedstInput {
        label: @tr("admin" => "Owner id");
        placeholder: @tr("admin" => "Show only the tasks of one owner (id)");
        invalid: AdminStore.filter-invalid;
        horizontal-stretch: 1;
        accepted => { AdminStore.filter-owner(self.text); }
    }
    AedstButton {
        text: @tr("admin" => "Apply");
        variant: AedstButtonVariant.secondary;
        clicked => { AdminStore.filter-owner(field.text); }
    }
}

export component AdminListView inherits Rectangle {
    background: AedstTokens.background;

    VerticalLayout {
        padding: AedstTokens.spacing-lg;
        spacing: AedstTokens.spacing-md;

        AedstLabel {
            text: @tr("admin" => "Administration");
            font-size: AedstTokens.typography-title-large-font-size;
            font-weight: AedstTokens.typography-title-large-font-weight;
            vertical-stretch: 0;
        }

        if AdminStore.no-access: VerticalLayout {
            alignment: start;
            vertical-stretch: 1;
            spacing: AedstTokens.spacing-sm;
            AedstLabel { text: @tr("admin" => "No access"); font-weight: 600; }
            AedstLabel {
                text: @tr("admin" => "This screen is for operators only.");
                color: AedstTokens.muted-foreground;
            }
        }

        if !AdminStore.no-access: VerticalLayout {
            spacing: AedstTokens.spacing-md;
            TabStrip {}

            if AdminStore.tab == AdminTab.tasks: OwnerFilter {}
            if AdminStore.tab == AdminTab.tasks && AdminStore.filter-invalid: AedstLabel {
                text: AdminTexts.validation-text("idInvalid");
                color: AedstTokens.destructive;
                vertical-stretch: 0;
            }
            if AdminStore.tab == AdminTab.tasks && AdminStore.delete-state != AdminDeleteState.idle: DeleteConfirm { vertical-stretch: 0; }

            if AdminStore.tab != AdminTab.broadcast && AdminStore.phase == AdminPhase.loading: AedstLabel {
                text: @tr("admin" => "Loading...");
                color: AedstTokens.muted-foreground;
                vertical-stretch: 0;
            }
            if AdminStore.tab != AdminTab.broadcast && AdminStore.phase == AdminPhase.failed: VerticalLayout {
                spacing: AedstTokens.spacing-sm;
                alignment: start;
                vertical-stretch: 0;
                AedstLabel { text: @tr("admin" => "Could not load"); font-weight: 600; }
                AedstLabel { text: AdminTexts.kind-text(AdminStore.error-kind); color: AedstTokens.destructive; }
                AedstButton { text: @tr("admin" => "Try again"); variant: AedstButtonVariant.secondary; clicked => { AdminStore.reload(); } }
            }
            if AdminStore.tab != AdminTab.broadcast && AdminStore.phase == AdminPhase.ready && AdminStore.error-kind != "": AedstLabel {
                text: AdminTexts.kind-text(AdminStore.error-kind);
                color: AedstTokens.destructive;
                vertical-stretch: 0;
            }
            if AdminStore.phase == AdminPhase.ready && ((AdminStore.tab == AdminTab.tasks && AdminStore.tasks.length == 0)
                || (AdminStore.tab == AdminTab.audit && AdminStore.audit.length == 0)): AedstLabel {
                text: @tr("admin" => "Nothing to show here.");
                color: AedstTokens.muted-foreground;
                vertical-stretch: 0;
            }

            // The overview (a fixed handful of rows) and the broadcast form scroll as one page; the two
            // paged lists are ListViews so only their visible rows exist (slint-rules M1).
            if AdminStore.tab == AdminTab.overview || AdminStore.tab == AdminTab.broadcast: Flickable {
                vertical-stretch: 1;
                min-height: 160px;
                content-height: page.preferred-height;
                page := VerticalLayout {
                    spacing: AedstTokens.spacing-xs;
                    alignment: start;
                    if AdminStore.tab == AdminTab.overview: VerticalLayout {
                        spacing: AedstTokens.spacing-xs;
                        for item in AdminStore.overview-items: OverviewRow { data: item; }
                    }
                    if AdminStore.tab == AdminTab.broadcast: BroadcastForm {}
                }
            }
            if AdminStore.tab == AdminTab.tasks: ListView {
                vertical-stretch: 1;
                min-height: 160px;
                for task in AdminStore.tasks: VerticalLayout {
                    padding-bottom: AedstTokens.spacing-xs;
                    TaskRow { data: task; }
                }
            }
            if AdminStore.tab == AdminTab.audit: ListView {
                vertical-stretch: 1;
                min-height: 160px;
                for entry in AdminStore.audit: VerticalLayout {
                    padding-bottom: AedstTokens.spacing-xs;
                    AuditRow { data: entry; }
                }
            }

            if AdminStore.has-more && AdminStore.tab != AdminTab.overview && AdminStore.tab != AdminTab.broadcast: AedstButton {
                text: AdminStore.loading-more ? @tr("admin" => "Loading...") : @tr("admin" => "Load more");
                variant: AedstButtonVariant.secondary;
                vertical-stretch: 0;
                clicked => { AdminStore.load-more(); }
            }
        }
    }
}

// A window for running the screen on its own (the example and screenshots). The app shell embeds
// `AdminListView` in its own window instead.
export component AdminDemoWindow inherits Window {
    in-out property <bool> rtl <=> AedstLayout.rtl;
    in-out property <bool> dark <=> AedstTokens.dark;
    title: @tr("admin" => "Administration");
    background: AedstTokens.background;
    min-width: 720px;
    min-height: 640px;
    preferred-width: 720px;
    preferred-height: 640px;
    AdminListView {}
}
