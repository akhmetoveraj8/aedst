// Translated helpers. Every message is the text of a KIND or a key, never a raw server message.
export global AdminTexts {
    public pure function kind-text(kind: string) -> string {
        if (kind == "offline") { return @tr("" => "You are offline."); }
        if (kind == "unavailable") { return @tr("" => "The server is not available right now."); }
        if (kind == "timeout") { return @tr("" => "The request took too long."); }
        if (kind == "rateLimited") { return @tr("" => "Too many requests. Try again in a moment."); }
        if (kind == "unauthenticated") { return @tr("" => "Please sign in again."); }
        if (kind == "forbidden") { return @tr("" => "You do not have access to this."); }
        if (kind == "notFound") { return @tr("" => "This item no longer exists."); }
        if (kind == "invalidInput") { return @tr("" => "The server did not accept this input."); }
        if (kind == "conflict") { return @tr("" => "This item was changed elsewhere."); }
        if (kind == "upgradeRequired") { return @tr("" => "Please update the app to continue."); }
        return @tr("" => "Something went wrong.");
    }

    public pure function validation-text(key: string) -> string {
        if (key == "idInvalid") { return @tr("" => "Enter a valid user id or leave it empty."); }
        if (key == "titleRequired") { return @tr("" => "Enter a title."); }
        if (key == "titleTooLong") { return @tr("" => "The title is too long (120 characters at most)."); }
        if (key == "bodyTooLong") { return @tr("" => "The message is too long (1000 characters at most)."); }
        if (key == "linkInvalid") { return @tr("" => "The link must be an in-app path such as /tasks."); }
        if (key == "reasonTooShort") { return @tr("" => "Enter a reason (3 characters at least)."); }
        return @tr("" => "The reason is too long (500 characters at most).");
    }

    public pure function status-text(status: string) -> string {
        if (status == "todo") { return @tr("" => "To do"); }
        if (status == "in-progress") { return @tr("" => "In progress"); }
        if (status == "done") { return @tr("" => "Done"); }
        return @tr("" => "Unknown");
    }

    public pure function overview-label(key: string) -> string {
        if (key == "tasks") { return @tr("" => "Tasks"); }
        if (key == "tasksDone") { return @tr("" => "Tasks done"); }
        if (key == "tasksOverdue") { return @tr("" => "Tasks overdue"); }
        if (key == "media") { return @tr("" => "Media files"); }
        if (key == "mediaBytes") { return @tr("" => "Media size"); }
        if (key == "pushDevices") { return @tr("" => "Push devices"); }
        if (key == "jobLag") { return @tr("" => "Oldest waiting job (seconds)"); }
        return @tr("" => "Jobs pending");
    }
}
