msgstr "Фиристодани огоҳинома"

msgctxt "admin"
msgid "You are offline."
msgstr "Шумо ба шабака пайваст нестед."

msgctxt "admin"
msgid "The server is not available right now."
msgstr "Сервер ҳоло дастнорас аст."

msgctxt "admin"
msgid "The request took too long."
msgstr "Дархост хеле тӯл кашид."

msgctxt "admin"
msgid "Too many requests. Try again in a moment."
msgstr "Дархостҳо аз ҳад зиёданд. Баъд аз лаҳзае боз кӯшиш кунед."

msgctxt "admin"
msgid "Please sign in again."
msgstr "Лутфан, бори дигар ворид шавед."

msgctxt "admin"
msgid "You do not have access to this."
msgstr "Шумо ба ин дастрасӣ надоред."

msgctxt "admin"
msgid "This item no longer exists."
msgstr "Ин ҷузъ дигар вуҷуд надорад."

msgctxt "admin"
msgid "The server did not accept this input."
msgstr "Сервер ин маълумотро қабул накард."

msgctxt "admin"
msgid "This item was changed elsewhere."
msgstr "Ин ҷузъ дар ҷои дигар тағйир дода шуд."

msgctxt "admin"
msgid "Please update the app to continue."
msgstr "Барои идома додан барномаро навсозӣ кунед."

msgctxt "admin"
msgid "Something went wrong."
msgstr "Чизе нодуруст рафт."

msgctxt "admin"
msgid "Enter a valid user id or leave it empty."
msgstr "Идентификатори дурусти корбарро ворид кунед ё майдонро холӣ монед."

msgctxt "admin"
msgid "The title is too long (120 characters at most)."
msgstr "Сарлавҳа хеле дароз аст (на зиёда аз 120 аломат)."

msgctxt "admin"
msgid "The message is too long (1000 characters at most)."
msgstr "Паём хеле дароз аст (на зиёда аз 1000 аломат)."

msgctxt "admin"
msgid "The link must be an in-app path such as /tasks."
msgstr "Истинод бояд роҳи дохили барнома бошад, масалан /tasks."

msgctxt "admin"
msgid "Enter a reason (3 characters at least)."
msgstr "Сабабро ворид кунед (ақаллан 3 аломат)."

msgctxt "admin"
msgid "The reason is too long (500 characters at most)."
msgstr "Сабаб хеле дароз аст (на зиёда аз 500 аломат)."

msgctxt "admin"
msgid "To do"
msgstr "Бояд иҷро шавад"

msgctxt "admin"
msgid "Unknown"
msgstr "Номаълум"

msgctxt "admin"
msgid "Tasks done"
msgstr "Вазифаҳои иҷрошуда"

msgctxt "admin"
msgid "Tasks overdue"
msgstr "Вазифаҳои гузашта"

msgctxt "admin"
msgid "Media files"
msgstr "Файлҳои медиа"

msgctxt "admin"
msgid "Media size"
msgstr "Ҳаҷми медиа"

msgctxt "admin"
msgid "Oldest waiting job (seconds)"
msgstr "Кӯҳнатарин кори интизор (сонияҳо)"

msgctxt "admin"
msgid "Jobs pending"
msgstr "Корҳо дар навбат"
