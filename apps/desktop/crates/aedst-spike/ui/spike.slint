// Spike: does Slint cope with Arabic text, a mirrored row and accessible names?
// The colours here are spike-only; production UI uses generated design tokens.
import { Button, LineEdit } from "std-widgets.slint";

export component Spike inherits Window {
    in property <bool> rtl: false;
    title: "AEDST spike";
    preferred-width: 480px;
    preferred-height: 240px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "مرحبا بالعالم، هذه مهمة جديدة 123";
            accessible-role: text;
            accessible-label: "Arabic sample";
        }

        LineEdit {
            placeholder-text: "اكتب هنا";
            accessible-label: "Task title";
        }

        // A row that must be reversed by hand when rtl is true.
        HorizontalLayout {
            spacing: 8px;
            alignment: root.rtl ? end : start;
            Button {
                text: "حفظ";
                accessible-description: "Save task";
            }
            Button {
                text: "إلغاء";
                accessible-description: "Cancel";
            }
        }
    }
}
