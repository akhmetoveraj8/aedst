// The application window: sign-in, the navigation sidebar and the five feature views.
// Every feature view is compiled in THIS compilation (see build.rs); the Rust glue of each feature is
// compiled against the types generated here, so every store, row struct and text global the glue uses
// is re-exported below (enums included).
import { AedstTokens, AedstLayout, AedstLabel, AedstButton, AedstBadge, AedstCheckbox, AedstButtonVariant, AedstBadgeVariant } from "@aedst-ui";
import { TasksListView } from "../../aedst-feature-tasks/ui/tasks.slint";
import { SearchListView } from "../../aedst-feature-search/ui/search.slint";
import { NotificationsListView, NotificationPreferencesView } from "../../aedst-feature-notifications/ui/notifications.slint";
import { MediaListView } from "../../aedst-feature-media/ui/media.slint";
import { AdminListView } from "../../aedst-feature-admin/ui/admin.slint";

export { TasksStore, TaskRowData, TaskTexts, TasksPhase, TasksCreateState } from "../../aedst-feature-tasks/ui/tasks.slint";
export { HitRowData, SearchStore, SearchTexts, SearchPhase } from "../../aedst-feature-search/ui/search.slint";
export { NotificationRowData, NotificationsStore, NotificationsTexts, NotificationsPhase } from "../../aedst-feature-notifications/ui/notifications.slint";
export { MediaRowData, MediaStore, MediaPhase, MediaUploadState, MediaUploadStage, MediaUploadCleanup, MediaViewerPhase } from "../../aedst-feature-media/ui/media.slint";
export { MediaTexts } from "../../aedst-feature-media/ui/media_texts.slint";
export { AdminStore, OverviewItemData, AdminTaskRowData, AuditRowData, AdminTab, AdminPhase, AdminDeleteState, AdminBroadcastState } from "../../aedst-feature-admin/ui/admin.slint";
export { AdminTexts } from "../../aedst-feature-admin/ui/admin_texts.slint";
export { AedstLayout, AedstTokens } from "@aedst-ui";

// The contract between the shell window and `aedst-desktop`'s Rust code: typed, so a mistyped screen
// or section is a compile error on both sides instead of a blank window.
export enum ShellScreen { starting, login, app, upgrade }
export enum ShellSection { tasks, search, notifications, media, admin, privacy }
export enum SignInError { no-error, failed, unreachable, keychain, timeout, unconfigured }
export enum UpdateBanner { hidden, available, downloading, ready }
enum InboxScreen { inbox, preferences }

export global ShellState {
    in property <ShellScreen> screen: ShellScreen.starting;
    in-out property <ShellSection> section: ShellSection.tasks;
    in property <bool> busy;
    in property <SignInError> sign-in-error: SignInError.no-error;
    // False until the services are built (and forever when they could not be): nothing would handle
    // the sign-in button.
    in property <bool> sign-in-available;
    in property <bool> show-admin;
    in property <int> unread;
    in property <UpdateBanner> update-phase: UpdateBanner.hidden;
    in property <int> update-percent;
    // Consent: separate opt-ins, both off until the user says yes; `*-available` is false when the
    // build has no DSN / key, so the switch cannot do anything.
    in property <bool> crash-consent;
    in property <bool> analytics-consent;
    in property <bool> crash-available;
    in property <bool> analytics-available;
    callback install-update();
    callback set-crash-consent(bool);
    callback set-analytics-consent(bool);
    callback sign-in();
    callback cancel-sign-in();
    callback sign-out();
    callback select(ShellSection);
}

component Sidebar inherits Rectangle {
    background: AedstTokens.card;
    border-width: 1px;
    border-color: AedstTokens.border;
    min-width: 200px;
    max-width: 200px;

    VerticalLayout {
        padding: AedstTokens.spacing-md;
        spacing: AedstTokens.spacing-sm;
        alignment: start;
        AedstLabel {
            text: "AEDST";
            font-size: AedstTokens.typography-title-large-font-size;
            font-weight: AedstTokens.typography-title-large-font-weight;
        }
        AedstButton {
            text: @tr("desktop" => "Tasks");
            variant: ShellState.section == ShellSection.tasks ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.tasks); }
        }
        AedstButton {
            text: @tr("desktop" => "Search");
            variant: ShellState.section == ShellSection.search ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.search); }
        }
        AedstButton {
            text: @tr("desktop" => "Notifications");
            variant: ShellState.section == ShellSection.notifications ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.notifications); }
        }
        if ShellState.unread > 0: AedstBadge { text: "\{ShellState.unread}"; variant: AedstBadgeVariant.destructive; }
        AedstButton {
            text: @tr("desktop" => "Files");
            variant: ShellState.section == ShellSection.media ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.media); }
        }
        if ShellState.show-admin: AedstButton {
            text: @tr("desktop" => "Admin");
            variant: ShellState.section == ShellSection.admin ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.admin); }
        }
        AedstButton {
            text: @tr("desktop" => "Privacy");
            variant: ShellState.section == ShellSection.privacy ? AedstButtonVariant.default : AedstButtonVariant.secondary;
            clicked => { ShellState.select(ShellSection.privacy); }
        }
        Rectangle { vertical-stretch: 1; }
        if ShellState.update-phase == UpdateBanner.available: AedstLabel {
            text: @tr("desktop" => "A new version is available");
            color: AedstTokens.muted-foreground;
        }
        if ShellState.update-phase == UpdateBanner.downloading: AedstLabel {
            text: @tr("desktop" => "Downloading the update: {}%", ShellState.update-percent);
            color: AedstTokens.muted-foreground;
        }
        if ShellState.update-phase == UpdateBanner.ready: AedstButton {
            text: @tr("desktop" => "Restart to update");
            clicked => { ShellState.install-update(); }
        }
        AedstButton {
            text: @tr("desktop" => "Sign out");
            variant: AedstButtonVariant.secondary;
            clicked => { ShellState.sign-out(); }
        }
    }
}

// One consent switch with its explanation; the checkbox sits at the reading start.
component ConsentRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> checked;
    in property <bool> available;
    callback toggled();
    min-height: 64px;
    max-height: 96px;

    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-md;
        AedstCheckbox { checked: root.checked; enabled: root.available; label: root.title; toggled => { root.toggled(); } }
        VerticalLayout {
            spacing: AedstTokens.spacing-xs;
            AedstLabel { text: root.title; font-weight: 600; }
            AedstLabel { text: root.detail; color: AedstTokens.muted-foreground; }
            if !root.available: AedstLabel { text: @tr("desktop" => "Not available in this build."); color: AedstTokens.muted-foreground; }
        }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-md;
        VerticalLayout {
            spacing: AedstTokens.spacing-xs;
            AedstLabel { text: root.title; font-weight: 600; }
            AedstLabel { text: root.detail; color: AedstTokens.muted-foreground; }
            if !root.available: AedstLabel { text: @tr("desktop" => "Not available in this build."); color: AedstTokens.muted-foreground; }
        }
        AedstCheckbox { checked: root.checked; enabled: root.available; label: root.title; toggled => { root.toggled(); } }
    }
}

component PrivacyView inherits Rectangle {
    background: AedstTokens.background;
    VerticalLayout {
        padding: AedstTokens.spacing-lg;
        spacing: AedstTokens.spacing-md;
        alignment: start;
        AedstLabel {
            text: @tr("desktop" => "Privacy");
            font-size: AedstTokens.typography-title-large-font-size;
            font-weight: AedstTokens.typography-title-large-font-weight;
        }
        AedstLabel {
            text: @tr("desktop" => "Nothing is sent unless you choose it here. Personal data is removed before anything leaves this device.");
            color: AedstTokens.muted-foreground;
        }
        ConsentRow {
            title: @tr("desktop" => "Send crash reports");
            detail: @tr("desktop" => "Technical details about a failure, so it can be fixed.");
            checked: ShellState.crash-consent;
            available: ShellState.crash-available;
            toggled => { ShellState.set-crash-consent(!ShellState.crash-consent); }
        }
        ConsentRow {
            title: @tr("desktop" => "Share anonymous usage statistics");
            detail: @tr("desktop" => "Which features are used, never what you type.");
            checked: ShellState.analytics-consent;
            available: ShellState.analytics-available;
            toggled => { ShellState.set-analytics-consent(!ShellState.analytics-consent); }
        }
    }
}

component Content inherits Rectangle {
    background: AedstTokens.background;
    property <InboxScreen> inbox-screen: InboxScreen.inbox;

    if ShellState.section == ShellSection.tasks: TasksListView {}
    if ShellState.section == ShellSection.search: SearchListView {}
    if ShellState.section == ShellSection.notifications: VerticalLayout {
        HorizontalLayout {
            padding: AedstTokens.spacing-md;
            spacing: AedstTokens.spacing-sm;
            alignment: AedstLayout.rtl ? end : start;
            vertical-stretch: 0;
            AedstButton {
                text: @tr("desktop" => "Inbox");
                variant: root.inbox-screen == InboxScreen.inbox ? AedstButtonVariant.default : AedstButtonVariant.secondary;
                clicked => { root.inbox-screen = InboxScreen.inbox; }
            }
            AedstButton {
                text: @tr("desktop" => "Preferences");
                variant: root.inbox-screen == InboxScreen.preferences ? AedstButtonVariant.default : AedstButtonVariant.secondary;
                clicked => { root.inbox-screen = InboxScreen.preferences; }
            }
        }
        if root.inbox-screen == InboxScreen.inbox: NotificationsListView {}
        if root.inbox-screen == InboxScreen.preferences: NotificationPreferencesView {}
    }
    if ShellState.section == ShellSection.media: MediaListView {}
    if ShellState.section == ShellSection.admin: AdminListView {}
    if ShellState.section == ShellSection.privacy: PrivacyView {}
}

component Notice inherits VerticalLayout {
    in property <string> title;
    in property <string> body;
    alignment: center;
    padding: AedstTokens.spacing-lg * 2;
    spacing: AedstTokens.spacing-md;
    AedstLabel {
        text: root.title;
        font-size: AedstTokens.typography-title-large-font-size;
        font-weight: AedstTokens.typography-title-large-font-weight;
    }
    if root.body != "": AedstLabel { text: root.body; color: AedstTokens.muted-foreground; }
    @children
}

export component AppWindow inherits Window {
    in-out property <bool> rtl <=> AedstLayout.rtl;
    in-out property <bool> dark <=> AedstTokens.dark;
    title: "AEDST";
    background: AedstTokens.background;
    min-width: 900px;
    min-height: 620px;
    preferred-width: 1100px;
    preferred-height: 720px;

    if ShellState.screen == ShellScreen.starting: Notice { title: @tr("desktop" => "Starting..."); body: ""; }

    if ShellState.screen == ShellScreen.login: Notice {
        title: @tr("desktop" => "Sign in to continue");
        body: ShellState.sign-in-error == SignInError.failed ? @tr("desktop" => "Sign-in failed. Please try again.")
            : ShellState.sign-in-error == SignInError.unreachable ? @tr("desktop" => "Could not reach the identity provider.")
            : ShellState.sign-in-error == SignInError.keychain ? @tr("desktop" => "Secure storage is not available on this device.")
            : ShellState.sign-in-error == SignInError.timeout ? @tr("desktop" => "Sign-in timed out.")
            : ShellState.sign-in-error == SignInError.unconfigured ? @tr("desktop" => "Sign-in is not configured.")
            : ShellState.busy ? @tr("desktop" => "Waiting for the browser...") : "";
        if !ShellState.busy: AedstButton {
            text: @tr("desktop" => "Continue in browser");
            enabled: ShellState.sign-in-available && ShellState.sign-in-error != SignInError.unconfigured;
            clicked => { ShellState.sign-in(); }
        }
        if ShellState.busy: AedstButton {
            text: @tr("desktop" => "Cancel");
            variant: AedstButtonVariant.secondary;
            clicked => { ShellState.cancel-sign-in(); }
        }
    }

    if ShellState.screen == ShellScreen.upgrade: Notice {
        title: @tr("desktop" => "Update required");
        body: @tr("desktop" => "This version of the app is too old for the server. Please update it to continue.");
    }

    // The sidebar sits at the reading start: left in LTR, right in RTL (Slint cannot reverse a layout).
    if ShellState.screen == ShellScreen.app && !AedstLayout.rtl: HorizontalLayout {
        Sidebar {}
        Content {}
    }
    if ShellState.screen == ShellScreen.app && AedstLayout.rtl: HorizontalLayout {
        Content {}
        Sidebar {}
    }
}
