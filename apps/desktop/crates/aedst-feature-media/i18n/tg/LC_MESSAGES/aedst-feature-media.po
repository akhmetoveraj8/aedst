msgid "Try again"
msgstr "Бори дигар"

msgctxt "media"
msgid "No files yet"
msgstr "Ҳоло файл нест"

msgctxt "media"
msgid "Upload your first file above."
msgstr "Аввалин файли худро дар боло бор кунед."

msgctxt "media"
msgid "Load more"
msgstr "Бештар"

msgctxt "media"
msgid "Back"
msgstr "Бозгашт"

msgctxt "media"
msgid "View"
msgstr "Кушодан"

msgctxt "media"
msgid "Delete this file?"
msgstr "Ин файл нест карда шавад?"

msgctxt "media"
msgid "Cancel"
msgstr "Бекор кардан"

msgctxt "media"
msgid "You are offline. Try again when you are connected."
msgstr "Шумо онлайн нестед. Ҳангоми пайвастшавӣ бори дигар кӯшиш кунед."

msgctxt "media"
msgid "The server is not available right now."
msgstr "Сервер ҳозир дастнорас аст."

msgctxt "media"
msgid "The request took too long."
msgstr "Дархост хеле тӯл кашид."

msgctxt "media"
msgid "Too many requests. Try again in a moment."
msgstr "Дархостҳо хеле зиёданд. Баъдтар бори дигар кӯшиш кунед."

msgctxt "media"
msgid "Please sign in again."
msgstr "Лутфан, бори дигар ворид шавед."

msgctxt "media"
msgid "You do not have access to this."
msgstr "Шумо ба ин дастрасӣ надоред."

msgctxt "media"
msgid "This file no longer exists."
msgstr "Ин файл дигар вуҷуд надорад."

msgctxt "media"
msgid "The server did not accept this file."
msgstr "Сервер ин файлро қабул накард."

msgctxt "media"
msgid "This file was changed elsewhere."
msgstr "Ин файл дар ҷои дигар тағйир дода шуд."

msgctxt "media"
msgid "Please update the app to continue."
msgstr "Барои идома додан барномаро навсозӣ кунед."

msgctxt "media"
msgid "Could not read the file on this device."
msgstr "Файлро дар ин дастгоҳ хондан нашуд."

msgctxt "media"
msgid "Something went wrong."
msgstr "Чизе хато шуд."

msgctxt "media"
msgid "The file is empty."
msgstr "Файл холӣ аст."

msgctxt "media"
msgid "The file is too large."
msgstr "Файл хеле калон аст."

msgctxt "media"
msgid "This type of file is not supported."
msgstr "Ин навъи файл дастгирӣ намешавад."

msgctxt "media"
msgid "The file name is empty or too long."
msgstr "Номи файл холӣ ё хеле дароз аст."

msgctxt "media"
msgid "The task for this file is not valid."
msgstr "Вазифа барои ин файл дуруст нест."

msgctxt "media"
msgid "Image"
msgstr "Тасвир"

msgctxt "media"
msgid "Video"
msgstr "Видео"

msgctxt "media"
msgid "Audio"
msgstr "Аудио"

msgctxt "media"
msgid "Document"
msgstr "Ҳуҷҷат"

msgctxt "media"
msgid "Unknown"
msgstr "Номаълум"

msgctxt "media"
msgid "Uploading"
msgstr "Бор шуда истодааст"

msgctxt "media"
msgid "Processing"
msgstr "Коркард мешавад"

msgctxt "media"
msgid "Ready"
msgstr "Тайёр"

msgctxt "media"
msgid "The uploaded size did not match the file."
msgstr "Ҳаҷми боршуда ба ҳаҷми файл мувофиқ наомад."

msgctxt "media"
msgid "The content did not match the file type."
msgstr "Мӯҳтаво ба навъи файл мувофиқ нест."

msgctxt "media"
msgid "The file could not be processed."
msgstr "Файлро коркард кардан нашуд."

msgctxt "media"
msgid "{} B"
msgstr "{} Б"

msgctxt "media"
msgid "{} KB"
msgstr "{} КБ"

msgctxt "media"
msgid "{} MB"
msgstr "{} МБ"

msgctxt "media"
msgid "Checking the file..."
msgstr "Файл санҷида истодааст..."

msgctxt "media"
msgid "Requesting the upload..."
msgstr "Дархости боркунӣ..."

msgctxt "media"
msgid "Uploading..."
msgstr "Боркунӣ..."

msgctxt "media"
msgid "Finishing..."
msgstr "Анҷом дода истодааст..."

msgctxt "media"
msgid "This file cannot be uploaded."
msgstr "Ин файлро бор кардан мумкин нест."

msgctxt "media"
msgid "Could not start the upload."
msgstr "Боркуниро оғоз кардан нашуд."

msgctxt "media"
msgid "Could not send the file."
msgstr "Файлро фиристодан нашуд."

msgctxt "media"
msgid "Could not finish the upload."
msgstr "Боркуниро анҷом додан нашуд."

msgctxt "media"
msgid "The unfinished upload was removed from the server."
msgstr "Боркунии нотамом аз сервер нест карда шуд."

msgctxt "media"
msgid "An unfinished upload may remain on the server and will expire."
msgstr "Боркунии нотамом шояд дар сервер бимонад ва бо мурури вақт аз эътибор меафтад."

msgctxt "media"
msgid "This file is not ready yet."
msgstr "Ин файл ҳоло тайёр нест."

msgctxt "media"
msgid "Video playback is not available yet."
msgstr "Пахши видео ҳоло дастрас нест."

msgctxt "media"
msgid "No preview is available for this kind of file."
msgstr "Барои ин навъи файл пешнамоиш нест."

msgctxt "media"
msgid "This image is too large to show."
msgstr "Ин тасвир барои намоиш хеле калон аст."

msgctxt "media"
msgid "This image could not be shown."
msgstr "Ин тасвирро нишон додан нашуд."
