// The Media screens: library with upload, and the image viewer. Stateless: they render
// `MediaStore` and call its callbacks; Rust (`ui_glue.rs`) owns the state. Only `aedst-ui`
// components are used; no raw std-widgets control.
import { AedstTokens, AedstLayout, AedstLabel, AedstButton, AedstButtonVariant } from "@aedst-ui";
import { ListView } from "std-widgets.slint"; // rows are created lazily only directly inside a ListView (slint-rules M1)
import { MediaStore, MediaPhase, MediaUploadState, MediaUploadStage, MediaViewerPhase } from "media_store.slint";
import { MediaTexts } from "media_texts.slint";
import { MediaRow } from "media_row.slint";

export { MediaRowData, MediaStore, MediaPhase, MediaUploadState, MediaUploadStage, MediaUploadCleanup, MediaViewerPhase } from "media_store.slint";
export { MediaTexts } from "media_texts.slint";

component UploadPanel inherits VerticalLayout {
    spacing: AedstTokens.spacing-sm;
    vertical-stretch: 0;

    HorizontalLayout {
        alignment: AedstLayout.rtl ? end : start;
        AedstButton {
            text: @tr("media" => "Upload file");
            enabled: MediaStore.upload-state != MediaUploadState.running;
            clicked => { MediaStore.pick-upload(); }
        }
    }
    if MediaStore.upload-state == MediaUploadState.running: VerticalLayout {
        spacing: AedstTokens.spacing-xs;
        AedstLabel { text: MediaStore.upload-file-name; font-weight: 600; }
        AedstLabel {
            text: MediaStore.upload-stage == MediaUploadStage.uploading
                ? @tr("media" => "Uploading... {}%", MediaStore.upload-percent)
                : MediaTexts.stage-text(MediaStore.upload-stage);
            color: AedstTokens.muted-foreground;
        }
        // The progress bar fills from the reading start edge.
        Rectangle {
            height: 8px;
            border-radius: AedstTokens.radius-full;
            background: AedstTokens.secondary;
            Rectangle {
                width: parent.width * MediaStore.upload-percent / 100;
                x: AedstLayout.rtl ? parent.width - self.width : 0px;
                border-radius: AedstTokens.radius-full;
                background: AedstTokens.primary;
            }
        }
    }
    if MediaStore.upload-state == MediaUploadState.failed: VerticalLayout {
        spacing: AedstTokens.spacing-xs;
        AedstLabel { text: MediaStore.upload-file-name; font-weight: 600; }
        AedstLabel { text: MediaTexts.stage-failed-text(MediaStore.upload-stage); color: AedstTokens.destructive; }
        AedstLabel {
            text: MediaStore.upload-reason-is-validation
                ? MediaTexts.validation-text(MediaStore.upload-reason)
                : MediaTexts.kind-text(MediaStore.upload-reason);
            color: AedstTokens.destructive;
        }
        if MediaTexts.cleanup-text(MediaStore.upload-cleanup) != "": AedstLabel {
            text: MediaTexts.cleanup-text(MediaStore.upload-cleanup);
            color: AedstTokens.muted-foreground;
        }
        HorizontalLayout {
            alignment: AedstLayout.rtl ? end : start;
            AedstButton {
                text: @tr("media" => "Dismiss");
                variant: AedstButtonVariant.secondary;
                clicked => { MediaStore.dismiss-upload(); }
            }
        }
    }
}

component Library inherits VerticalLayout {
    padding: AedstTokens.spacing-lg;
    spacing: AedstTokens.spacing-md;

    AedstLabel {
        text: @tr("media" => "Media");
        font-size: AedstTokens.typography-title-large-font-size;
        font-weight: AedstTokens.typography-title-large-font-weight;
        vertical-stretch: 0;
        height: 32px;
    }
    UploadPanel {}

    if MediaStore.phase == MediaPhase.loading: AedstLabel {
        text: @tr("media" => "Loading...");
        color: AedstTokens.muted-foreground;
    }
    if MediaStore.phase == MediaPhase.failed: VerticalLayout {
        spacing: AedstTokens.spacing-sm;
        alignment: start;
        vertical-stretch: 0;
        AedstLabel { text: @tr("media" => "Could not load media"); font-weight: 600; }
        AedstLabel { text: MediaTexts.kind-text(MediaStore.error-kind); color: AedstTokens.destructive; }
        HorizontalLayout {
            alignment: AedstLayout.rtl ? end : start;
            AedstButton { text: @tr("media" => "Try again"); variant: AedstButtonVariant.secondary; clicked => { MediaStore.reload(); } }
        }
    }
    if MediaStore.phase == MediaPhase.ready && MediaStore.rows.length == 0: VerticalLayout {
        alignment: start;
        vertical-stretch: 0;
        AedstLabel { text: @tr("media" => "No files yet"); font-weight: 600; }
        AedstLabel { text: @tr("media" => "Upload your first file above."); color: AedstTokens.muted-foreground; }
    }
    if MediaStore.phase == MediaPhase.ready && MediaStore.error-kind != "": AedstLabel {
        text: MediaTexts.kind-text(MediaStore.error-kind);
        color: AedstTokens.destructive;
        vertical-stretch: 0;
    }

    ListView {
        vertical-stretch: 1;
        min-height: 160px;
        for row in MediaStore.rows: VerticalLayout {
            padding-bottom: AedstTokens.spacing-xs;
            MediaRow { data: row; }
        }
    }

    if MediaStore.has-more: AedstButton {
        text: @tr("media" => "Load more");
        variant: AedstButtonVariant.secondary;
        vertical-stretch: 0;
        clicked => { MediaStore.load-more(); }
    }
}

component Viewer inherits VerticalLayout {
    padding: AedstTokens.spacing-lg;
    spacing: AedstTokens.spacing-md;

    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        vertical-stretch: 0;
        height: 40px;
        AedstButton { text: @tr("media" => "Back"); variant: AedstButtonVariant.secondary; clicked => { MediaStore.close-viewer(); } }
        AedstLabel { text: MediaStore.viewer-title; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        vertical-stretch: 0;
        height: 40px;
        AedstLabel { text: MediaStore.viewer-title; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        AedstButton { text: @tr("media" => "Back"); variant: AedstButtonVariant.secondary; clicked => { MediaStore.close-viewer(); } }
    }

    if MediaStore.viewer-phase == MediaViewerPhase.ready: Image {
        source: MediaStore.viewer-image;
        image-fit: contain;
        vertical-stretch: 1;
        accessible-role: AccessibleRole.image;
        accessible-label: MediaStore.viewer-title;
    }
    if MediaStore.viewer-phase == MediaViewerPhase.failed: VerticalLayout {
        spacing: AedstTokens.spacing-sm;
        alignment: start;
        vertical-stretch: 1;
        AedstLabel { text: MediaTexts.kind-text(MediaStore.viewer-error-kind); color: AedstTokens.destructive; }
    }
    if MediaStore.viewer-phase != MediaViewerPhase.ready && MediaStore.viewer-phase != MediaViewerPhase.failed: VerticalLayout {
        alignment: start;
        vertical-stretch: 1;
        AedstLabel {
            text: MediaTexts.viewer-text(MediaStore.viewer-phase);
            color: MediaStore.viewer-phase == MediaViewerPhase.loading ? AedstTokens.muted-foreground : AedstTokens.foreground;
        }
    }
}

// The library, or the viewer on top of it while a file is open.
export component MediaListView inherits Rectangle {
    background: AedstTokens.background;
    if MediaStore.viewer-phase == MediaViewerPhase.closed: Library {}
    if MediaStore.viewer-phase != MediaViewerPhase.closed: Viewer {}
}

// A window for running the screens on their own (the example and screenshots). The app shell
// embeds `MediaListView` in its own window instead.
export component MediaDemoWindow inherits Window {
    in-out property <bool> rtl <=> AedstLayout.rtl;
    in-out property <bool> dark <=> AedstTokens.dark;
    title: @tr("media" => "Media");
    background: AedstTokens.background;
    min-width: 640px;
    min-height: 560px;
    preferred-width: 640px;
    preferred-height: 560px;
    MediaListView {}
}
