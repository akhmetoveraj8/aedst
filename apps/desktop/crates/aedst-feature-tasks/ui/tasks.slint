// The Tasks list screen. Stateless: it renders `TasksStore` and calls its callbacks; Rust
// (`ui_glue.rs`) owns the state. Only `aedst-ui` components are used; no raw std-widgets control.
import { AedstTokens, AedstLayout, AedstLabel, AedstButton, AedstInput, AedstBadge, AedstCheckbox, AedstButtonVariant, AedstBadgeVariant } from "@aedst-ui";
import { ListView } from "std-widgets.slint"; // rows are created lazily only directly inside a ListView (slint-rules M1)

export struct TaskRowData {
    id: string,
    title: string,
    status: string,   // todo | in-progress | done | unknown
    priority: string, // low | medium | high | urgent | unknown
    done: bool,
    pending: bool,
}

// The screen's states, typed: a mistyped state is a compile error in Slint and in the glue.
export enum TasksPhase { idle, loading, ready, failed }
export enum TasksCreateState { idle, sending, invalid, failed }

export global TasksStore {
    in property <[TaskRowData]> rows;
    in property <TasksPhase> phase: TasksPhase.idle;
    in property <string> error-kind;           // set when phase == failed, or a row action failed
    in property <TasksCreateState> create-state: TasksCreateState.idle;
    in property <string> create-error;         // a validation key or an error kind
    in property <int> total: -1;
    in property <bool> has-more;
    in property <int> pending-count;
    in-out property <string> priority: "medium";
    callback reload();
    callback load-more();
    callback create(string, string);           // title, priority key
    callback toggle(string);                   // task id
}

// Every message is the translated text of a KIND, never a raw server message.
export global TaskTexts {
    public pure function kind-text(kind: string) -> string {
        if (kind == "offline") { return @tr("tasks" => "You are offline. Changes will sync later."); }
        if (kind == "unavailable") { return @tr("tasks" => "The server is not available right now."); }
        if (kind == "timeout") { return @tr("tasks" => "The request took too long."); }
        if (kind == "rateLimited") { return @tr("tasks" => "Too many requests. Try again in a moment."); }
        if (kind == "unauthenticated") { return @tr("tasks" => "Please sign in again."); }
        if (kind == "forbidden") { return @tr("tasks" => "You do not have access to this."); }
        if (kind == "notFound") { return @tr("tasks" => "This task no longer exists."); }
        if (kind == "invalidInput") { return @tr("tasks" => "The server did not accept this input."); }
        if (kind == "conflict") { return @tr("tasks" => "This task was changed elsewhere."); }
        if (kind == "upgradeRequired") { return @tr("tasks" => "Please update the app to continue."); }
        if (kind == "storage") { return @tr("tasks" => "Could not save on this device."); }
        return @tr("tasks" => "Something went wrong.");
    }
    
    public pure function validation-text(key: string) -> string {
        if (key == "titleRequired") { return @tr("tasks" => "Enter a title."); }
        if (key == "titleTooLong") { return @tr("tasks" => "The title is too long (200 characters at most)."); }
        if (key == "descriptionTooLong") { return @tr("tasks" => "The description is too long."); }
        return @tr("tasks" => "Choose a priority.");
    }
    
    public pure function status-text(status: string) -> string {
        if (status == "todo") { return @tr("tasks" => "To do"); }
        if (status == "in-progress") { return @tr("tasks" => "In progress"); }
        if (status == "done") { return @tr("tasks" => "Done"); }
        return @tr("tasks" => "Unknown");
    }
    
    public pure function priority-text(priority: string) -> string {
        if (priority == "low") { return @tr("tasks" => "Low"); }
        if (priority == "medium") { return @tr("tasks" => "Medium"); }
        if (priority == "high") { return @tr("tasks" => "High"); }
        if (priority == "urgent") { return @tr("tasks" => "Urgent"); }
        return @tr("tasks" => "Unknown");
    }
}

component PriorityChoice inherits AedstButton {
    in property <string> key;
    text: TaskTexts.priority-text(root.key);
    variant: TasksStore.priority == root.key ? AedstButtonVariant.default : AedstButtonVariant.secondary;
    min-width: 72px;
    clicked => { TasksStore.priority = root.key; }
}

component AddTaskButton inherits AedstButton {
    callback submit();
    text: TasksStore.create-state == TasksCreateState.sending ? @tr("tasks" => "Adding...") : @tr("tasks" => "Add task");
    enabled: TasksStore.create-state != TasksCreateState.sending;
    clicked => { root.submit(); }
}

// Slint cannot reverse a layout, so the right-to-left order is spelled out here (the cost of
// mirroring recorded in ADR-0001). The group sits at the reading start: left in LTR, right in RTL.
component PriorityBar inherits HorizontalLayout {
    callback submit();
    spacing: AedstTokens.spacing-sm;
    alignment: AedstLayout.rtl ? end : start;
    vertical-stretch: 0;

    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        PriorityChoice { key: "low"; }
        PriorityChoice { key: "medium"; }
        PriorityChoice { key: "high"; }
        PriorityChoice { key: "urgent"; }
        AddTaskButton { submit => { root.submit(); } }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        AddTaskButton { submit => { root.submit(); } }
        PriorityChoice { key: "urgent"; }
        PriorityChoice { key: "high"; }
        PriorityChoice { key: "medium"; }
        PriorityChoice { key: "low"; }
    }
}

component TaskRow inherits Rectangle {
    in property <TaskRowData> data;
    height: 44px;
    border-radius: AedstTokens.radius-md;
    background: AedstTokens.card;
    border-width: 1px;
    border-color: AedstTokens.border;

    if !AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-sm;
        spacing: AedstTokens.spacing-sm;
        AedstCheckbox {
            checked: root.data.done;
            enabled: !root.data.pending;
            label: @tr("tasks" => "Mark \"{}\" as done", root.data.title);
            toggled => { TasksStore.toggle(root.data.id); }
        }
        AedstLabel { text: root.data.title; vertical-alignment: center; horizontal-stretch: 1; }
        AedstBadge { variant: AedstBadgeVariant.secondary; text: TaskTexts.priority-text(root.data.priority); }
        AedstBadge {
            text: TaskTexts.status-text(root.data.status);
            variant: root.data.status == "done" ? AedstBadgeVariant.success : AedstBadgeVariant.secondary;
        }
        if root.data.pending: AedstBadge { text: @tr("tasks" => "Pending sync"); variant: AedstBadgeVariant.destructive; }
    }
    if AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-sm;
        spacing: AedstTokens.spacing-sm;
        if root.data.pending: AedstBadge { text: @tr("tasks" => "Pending sync"); variant: AedstBadgeVariant.destructive; }
        AedstBadge {
            text: TaskTexts.status-text(root.data.status);
            variant: root.data.status == "done" ? AedstBadgeVariant.success : AedstBadgeVariant.secondary;
        }
        AedstBadge { variant: AedstBadgeVariant.secondary; text: TaskTexts.priority-text(root.data.priority); }
        AedstLabel { text: root.data.title; vertical-alignment: center; horizontal-stretch: 1; }
        AedstCheckbox {
            checked: root.data.done;
            enabled: !root.data.pending;
            label: @tr("tasks" => "Mark \"{}\" as done", root.data.title);
            toggled => { TasksStore.toggle(root.data.id); }
        }
    }
}

export component TasksListView inherits Rectangle {
    background: AedstTokens.background;

    VerticalLayout {
        padding: AedstTokens.spacing-lg;
        spacing: AedstTokens.spacing-md;

        HorizontalLayout {
            spacing: AedstTokens.spacing-sm;
            alignment: AedstLayout.rtl ? end : start;
            vertical-stretch: 0;
            height: 32px;
            if !AedstLayout.rtl: HorizontalLayout {
                spacing: AedstTokens.spacing-sm;
                AedstLabel {
                    text: @tr("tasks" => "Tasks");
                    font-size: AedstTokens.typography-title-large-font-size;
                    font-weight: AedstTokens.typography-title-large-font-weight;
                }
                if TasksStore.total >= 0: AedstBadge { variant: AedstBadgeVariant.secondary; text: @tr("tasks" => "{} in total", TasksStore.total); }
            }
            if AedstLayout.rtl: HorizontalLayout {
                spacing: AedstTokens.spacing-sm;
                if TasksStore.total >= 0: AedstBadge { variant: AedstBadgeVariant.secondary; text: @tr("tasks" => "{} in total", TasksStore.total); }
                AedstLabel {
                    text: @tr("tasks" => "Tasks");
                    font-size: AedstTokens.typography-title-large-font-size;
                    font-weight: AedstTokens.typography-title-large-font-weight;
                }
            }
        }

        if TasksStore.pending-count > 0: AedstBadge {
            text: @tr("tasks" => "Waiting to sync: {}", TasksStore.pending-count);
            variant: AedstBadgeVariant.destructive;
            vertical-stretch: 0;
        }

        // The create form.
        VerticalLayout {
            spacing: AedstTokens.spacing-sm;
            vertical-stretch: 0;
            title-field := AedstInput {
                label: @tr("tasks" => "New task title");
                placeholder: @tr("tasks" => "What needs to be done?");
                invalid: TasksStore.create-state == TasksCreateState.invalid;
                accepted => { TasksStore.create(self.text, TasksStore.priority); }
            }
            PriorityBar {
                submit => {
                    TasksStore.create(title-field.text, TasksStore.priority);
                    if (TasksStore.create-state != TasksCreateState.invalid) { title-field.text = ""; }
                }
            }
            if TasksStore.create-state == TasksCreateState.invalid: AedstLabel {
                text: TaskTexts.validation-text(TasksStore.create-error);
                color: AedstTokens.destructive;
            }
            if TasksStore.create-state == TasksCreateState.failed: AedstLabel {
                text: TaskTexts.kind-text(TasksStore.create-error);
                color: AedstTokens.destructive;
            }
        }

        if TasksStore.phase == TasksPhase.loading: AedstLabel {
            text: @tr("tasks" => "Loading...");
            color: AedstTokens.muted-foreground;
        }
        if TasksStore.phase == TasksPhase.failed: VerticalLayout {
            spacing: AedstTokens.spacing-sm;
            alignment: start;
            vertical-stretch: 0;
            AedstLabel { text: @tr("tasks" => "Could not load tasks"); font-weight: 600; }
            AedstLabel { text: TaskTexts.kind-text(TasksStore.error-kind); color: AedstTokens.destructive; }
            AedstButton { text: @tr("tasks" => "Try again"); variant: AedstButtonVariant.secondary; clicked => { TasksStore.reload(); } }
        }
        if TasksStore.phase == TasksPhase.ready && TasksStore.rows.length == 0: VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            AedstLabel { text: @tr("tasks" => "No tasks yet"); font-weight: 600; }
            AedstLabel { text: @tr("tasks" => "Add your first task above."); color: AedstTokens.muted-foreground; }
        }
        if TasksStore.phase == TasksPhase.ready && TasksStore.error-kind != "": AedstLabel {
            text: TaskTexts.kind-text(TasksStore.error-kind);
            color: AedstTokens.destructive;
        }

        ListView {
            vertical-stretch: 1;
            min-height: 160px;
            for row in TasksStore.rows: VerticalLayout {
                padding-bottom: AedstTokens.spacing-xs;
                TaskRow { data: row; }
            }
        }

        if TasksStore.has-more: AedstButton {
            text: @tr("tasks" => "Load more");
            variant: AedstButtonVariant.secondary;
            vertical-stretch: 0;
            clicked => { TasksStore.load-more(); }
        }
    }
}

// A window for running the screen on its own (the example and screenshots). The app shell embeds
// `TasksListView` in its own window instead.
export component TasksDemoWindow inherits Window {
    in-out property <bool> rtl <=> AedstLayout.rtl;
    in-out property <bool> dark <=> AedstTokens.dark;
    title: @tr("tasks" => "Tasks");
    background: AedstTokens.background;
    min-width: 640px;
    min-height: 560px;
    preferred-width: 640px;
    preferred-height: 560px;
    TasksListView {}
}
