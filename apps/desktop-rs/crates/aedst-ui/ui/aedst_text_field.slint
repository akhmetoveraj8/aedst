import { AedstTokens } from "aedst_tokens.slint";
import { AedstLayout } from "aedst_layout.slint";

// A single-line text field. `label` is what a screen reader announces (the placeholder is not a label).
export component AedstTextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> invalid: false;
    callback accepted();
    callback edited(string);

    preferred-height: 40px;
    min-height: 40px;
    max-height: 40px;
    border-radius: AedstTokens.radius-md;
    background: AedstTokens.background;
    border-width: input.has-focus ? 2px : 1px;
    border-color: root.invalid ? AedstTokens.destructive : (input.has-focus ? AedstTokens.ring : AedstTokens.input);
    accessible-role: text-input;
    accessible-label: root.label;
    forward-focus: input;

    input := TextInput {
        x: AedstTokens.spacing-sm;
        width: parent.width - 2 * AedstTokens.spacing-sm;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: AedstLayout.rtl ? right : left;
        color: AedstTokens.foreground;
        font-size: AedstTokens.typography-body-medium-font-size;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }

    if input.text == "": Text {
        x: AedstTokens.spacing-sm;
        width: parent.width - 2 * AedstTokens.spacing-sm;
        height: parent.height;
        text: root.placeholder;
        color: AedstTokens.muted-foreground;
        font-size: AedstTokens.typography-body-medium-font-size;
        vertical-alignment: center;
        horizontal-alignment: AedstLayout.rtl ? right : left;
    }
}
