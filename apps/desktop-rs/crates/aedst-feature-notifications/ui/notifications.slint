// The Notifications views: the inbox (`NotificationsListView`) and the preferences
// (`NotificationPreferencesView`). Stateless: they render `NotificationsStore` and call its
// callbacks; Rust (`ui_glue.rs`) owns the state. Only `aedst-ui` components are used.
import { AedstTokens, AedstLayout, AedstLabel, AedstButton, AedstBadge, AedstCheckbox } from "@aedst-ui";

export struct NotificationRowData {
    id: string,
    kind: string,    // task-completed | task-due-soon | media-ready | system | unknown
    title: string,
    body: string,
    created: string, // YYYY-MM-DD HH:MM (UTC), may be empty
    read: bool,
}

export global NotificationsStore {
    in property <[NotificationRowData]> rows;
    in property <string> phase: "idle";        // idle | loading | ready | failed
    in property <string> error-kind;           // set when phase == failed, or a mark/page action failed
    in property <bool> unread-only;
    in property <int> unread-count;
    in property <bool> has-more;
    in property <bool> marking-all;
    in property <string> prefs-phase: "idle";  // idle | loading | ready | failed
    in property <string> prefs-error-kind;     // load failure or save failure
    in property <bool> push-enabled;
    in property <bool> task-completed;
    in property <bool> task-due-soon;
    in property <bool> media-ready;
    callback reload();
    callback load-more();
    callback open(string);                     // notification id
    callback mark-all-read();
    callback set-unread-only(bool);
    callback reload-preferences();
    callback set-preference(string, bool);     // key, new value
}

// Every message is the translated text of a KIND, never a raw server message.
export global NotificationsTexts {
    public pure function error-text(kind: string) -> string {
        if (kind == "offline") { return @tr("" => "You are offline. Try again when you are connected."); }
        if (kind == "unavailable") { return @tr("" => "The server is not available right now."); }
        if (kind == "timeout") { return @tr("" => "The request took too long."); }
        if (kind == "rateLimited") { return @tr("" => "Too many requests. Try again in a moment."); }
        if (kind == "unauthenticated") { return @tr("" => "Please sign in again."); }
        if (kind == "forbidden") { return @tr("" => "You do not have access to this."); }
        if (kind == "notFound") { return @tr("" => "This notification no longer exists."); }
        if (kind == "invalidInput") { return @tr("" => "The server did not accept this input."); }
        if (kind == "conflict") { return @tr("" => "This was changed elsewhere."); }
        if (kind == "upgradeRequired") { return @tr("" => "Please update the app to continue."); }
        if (kind == "storage") { return @tr("" => "Could not save on this device."); }
        return @tr("" => "Something went wrong.");
    }

    public pure function kind-text(kind: string) -> string {
        if (kind == "task-completed") { return @tr("" => "Task completed"); }
        if (kind == "task-due-soon") { return @tr("" => "Task due soon"); }
        if (kind == "media-ready") { return @tr("" => "Media ready"); }
        if (kind == "system") { return @tr("" => "System"); }
        return @tr("" => "Other");
    }
}

component NotificationTexts inherits VerticalLayout {
    in property <NotificationRowData> data;
    spacing: AedstTokens.spacing-xxs;
    alignment: center;
    AedstLabel {
        text: root.data.title;
        font-weight: root.data.read ? 400 : 700;
        wrap: no-wrap;
        overflow: elide;
    }
    AedstLabel {
        text: root.data.body;
        color: AedstTokens.muted-foreground;
        font-size: AedstTokens.typography-body-small-font-size;
        wrap: no-wrap;
        overflow: elide;
    }
    AedstLabel {
        text: root.data.created;
        color: AedstTokens.muted-foreground;
        font-size: AedstTokens.typography-label-small-font-size;
        wrap: no-wrap;
    }
}

// One inbox row. Unread rows are tinted, outlined, bold and carry a dot; read rows are calm.
component NotificationRow inherits Rectangle {
    in property <NotificationRowData> data;
    height: 84px;
    border-radius: AedstTokens.radius-md;
    background: root.data.read ? AedstTokens.card : AedstTokens.accent;
    border-width: root.data.read ? 1px : 2px;
    border-color: root.data.read ? AedstTokens.border : AedstTokens.primary;
    accessible-role: button;
    accessible-label: root.data.read ? root.data.title : @tr("" => "Unread: {}", root.data.title);
    accessible-action-default => { NotificationsStore.open(root.data.id); }

    if !AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-md;
        spacing: AedstTokens.spacing-sm;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: AedstTokens.radius-full;
                background: root.data.read ? transparent : AedstTokens.primary;
            }
        }
        NotificationTexts { data: root.data; horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            AedstBadge { text: NotificationsTexts.kind-text(root.data.kind); }
        }
    }
    if AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-md;
        spacing: AedstTokens.spacing-sm;
        VerticalLayout {
            alignment: center;
            AedstBadge { text: NotificationsTexts.kind-text(root.data.kind); }
        }
        NotificationTexts { data: root.data; horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: AedstTokens.radius-full;
                background: root.data.read ? transparent : AedstTokens.primary;
            }
        }
    }

    TouchArea { clicked => { NotificationsStore.open(root.data.id); } }
}

component InboxHeader inherits HorizontalLayout {
    spacing: AedstTokens.spacing-sm;
    vertical-stretch: 0;
    height: 40px;
    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        horizontal-stretch: 1;
        VerticalLayout {
            alignment: center;
            AedstLabel {
                text: @tr("" => "Notifications");
                font-size: AedstTokens.typography-title-large-font-size;
                font-weight: AedstTokens.typography-title-large-font-weight;
                wrap: no-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            if NotificationsStore.unread-count > 0: AedstBadge {
                text: @tr("" => "{} unread", NotificationsStore.unread-count);
                tone: "danger";
            }
        }
        Rectangle { horizontal-stretch: 1; }
        AedstButton {
            text: NotificationsStore.marking-all ? @tr("" => "Marking...") : @tr("" => "Mark all as read");
            primary: false;
            enabled: !NotificationsStore.marking-all && NotificationsStore.unread-count > 0;
            clicked => { NotificationsStore.mark-all-read(); }
        }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        horizontal-stretch: 1;
        AedstButton {
            text: NotificationsStore.marking-all ? @tr("" => "Marking...") : @tr("" => "Mark all as read");
            primary: false;
            enabled: !NotificationsStore.marking-all && NotificationsStore.unread-count > 0;
            clicked => { NotificationsStore.mark-all-read(); }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            if NotificationsStore.unread-count > 0: AedstBadge {
                text: @tr("" => "{} unread", NotificationsStore.unread-count);
                tone: "danger";
            }
        }
        VerticalLayout {
            alignment: center;
            AedstLabel {
                text: @tr("" => "Notifications");
                font-size: AedstTokens.typography-title-large-font-size;
                font-weight: AedstTokens.typography-title-large-font-weight;
                wrap: no-wrap;
            }
        }
    }
}

component FilterBar inherits HorizontalLayout {
    spacing: AedstTokens.spacing-sm;
    alignment: AedstLayout.rtl ? end : start;
    vertical-stretch: 0;
    if !AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        AedstButton {
            text: @tr("" => "All");
            primary: !NotificationsStore.unread-only;
            clicked => { NotificationsStore.set-unread-only(false); }
        }
        AedstButton {
            text: @tr("" => "Unread");
            primary: NotificationsStore.unread-only;
            clicked => { NotificationsStore.set-unread-only(true); }
        }
    }
    if AedstLayout.rtl: HorizontalLayout {
        spacing: AedstTokens.spacing-sm;
        AedstButton {
            text: @tr("" => "Unread");
            primary: NotificationsStore.unread-only;
            clicked => { NotificationsStore.set-unread-only(true); }
        }
        AedstButton {
            text: @tr("" => "All");
            primary: !NotificationsStore.unread-only;
            clicked => { NotificationsStore.set-unread-only(false); }
        }
    }
}

export component NotificationsListView inherits Rectangle {
    background: AedstTokens.background;

    VerticalLayout {
        padding: AedstTokens.spacing-lg;
        spacing: AedstTokens.spacing-md;

        InboxHeader {}
        FilterBar {}

        if NotificationsStore.phase == "loading": AedstLabel {
            text: @tr("" => "Loading...");
            color: AedstTokens.muted-foreground;
            vertical-stretch: 0;
        }
        if NotificationsStore.phase == "failed": VerticalLayout {
            spacing: AedstTokens.spacing-sm;
            alignment: start;
            vertical-stretch: 0;
            AedstLabel { text: @tr("" => "Could not load notifications"); font-weight: 600; }
            AedstLabel { text: NotificationsTexts.error-text(NotificationsStore.error-kind); color: AedstTokens.destructive; }
            AedstButton { text: @tr("" => "Try again"); primary: false; clicked => { NotificationsStore.reload(); } }
        }
        if NotificationsStore.phase == "ready" && NotificationsStore.rows.length == 0: VerticalLayout {
            alignment: start;
            vertical-stretch: 0;
            AedstLabel {
                text: NotificationsStore.unread-only ? @tr("" => "No unread notifications") : @tr("" => "No notifications yet");
                font-weight: 600;
            }
            AedstLabel { text: @tr("" => "You are all caught up."); color: AedstTokens.muted-foreground; }
        }
        if NotificationsStore.phase == "ready" && NotificationsStore.error-kind != "": AedstLabel {
            text: NotificationsTexts.error-text(NotificationsStore.error-kind);
            color: AedstTokens.destructive;
            vertical-stretch: 0;
        }

        Flickable {
            vertical-stretch: 1;
            min-height: 160px;
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                spacing: AedstTokens.spacing-xs;
                for row in NotificationsStore.rows: NotificationRow { data: row; }
            }
        }

        if NotificationsStore.has-more: AedstButton {
            text: @tr("" => "Load more");
            primary: false;
            vertical-stretch: 0;
            clicked => { NotificationsStore.load-more(); }
        }
    }
}

// A labelled switch. The whole row is the click target.
component PreferenceRow inherits Rectangle {
    in property <string> key;
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    height: 44px;
    border-radius: AedstTokens.radius-md;
    background: AedstTokens.card;
    border-width: 1px;
    border-color: AedstTokens.border;

    if !AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-sm;
        spacing: AedstTokens.spacing-sm;
        AedstCheckbox {
            checked: root.checked;
            enabled: root.enabled;
            label: root.label;
            toggled => { NotificationsStore.set-preference(root.key, !root.checked); }
        }
        AedstLabel {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.enabled ? AedstTokens.foreground : AedstTokens.muted-foreground;
        }
    }
    if AedstLayout.rtl: HorizontalLayout {
        padding: AedstTokens.spacing-sm;
        spacing: AedstTokens.spacing-sm;
        AedstLabel {
            text: root.label;
            vertical-alignment: center;
            horizontal-stretch: 1;
            color: root.enabled ? AedstTokens.foreground : AedstTokens.muted-foreground;
        }
        AedstCheckbox {
            checked: root.checked;
            enabled: root.enabled;
            label: root.label;
            toggled => { NotificationsStore.set-preference(root.key, !root.checked); }
        }
    }
}

export component NotificationPreferencesView inherits Rectangle {
    background: AedstTokens.background;

    VerticalLayout {
        padding: AedstTokens.spacing-lg;
        spacing: AedstTokens.spacing-md;
        alignment: start;

        AedstLabel {
            text: @tr("" => "Notification preferences");
            font-size: AedstTokens.typography-title-large-font-size;
            font-weight: AedstTokens.typography-title-large-font-weight;
        }

        if NotificationsStore.prefs-phase == "loading": AedstLabel {
            text: @tr("" => "Loading...");
            color: AedstTokens.muted-foreground;
        }
        if NotificationsStore.prefs-phase == "failed": VerticalLayout {
            spacing: AedstTokens.spacing-sm;
            AedstLabel { text: @tr("" => "Could not load preferences"); font-weight: 600; }
            AedstLabel { text: NotificationsTexts.error-text(NotificationsStore.prefs-error-kind); color: AedstTokens.destructive; }
            AedstButton { text: @tr("" => "Try again"); primary: false; clicked => { NotificationsStore.reload-preferences(); } }
        }
        if NotificationsStore.prefs-phase == "ready": VerticalLayout {
            spacing: AedstTokens.spacing-sm;
            AedstLabel {
                text: @tr("" => "Choose which notifications you receive.");
                color: AedstTokens.muted-foreground;
            }
            PreferenceRow {
                key: "push-enabled";
                label: @tr("" => "Show notifications");
                checked: NotificationsStore.push-enabled;
            }
            PreferenceRow {
                key: "task-completed";
                label: @tr("" => "Task completed");
                checked: NotificationsStore.task-completed;
                enabled: NotificationsStore.push-enabled;
            }
            PreferenceRow {
                key: "task-due-soon";
                label: @tr("" => "Task due soon");
                checked: NotificationsStore.task-due-soon;
                enabled: NotificationsStore.push-enabled;
            }
            PreferenceRow {
                key: "media-ready";
                label: @tr("" => "Media ready");
                checked: NotificationsStore.media-ready;
                enabled: NotificationsStore.push-enabled;
            }
            if NotificationsStore.prefs-error-kind != "": AedstLabel {
                text: @tr("" => "Could not save the setting. {}", NotificationsTexts.error-text(NotificationsStore.prefs-error-kind));
                color: AedstTokens.destructive;
            }
        }
    }
}

// A window for running the views on their own (the example and screenshots). The app shell embeds
// `NotificationsListView` and `NotificationPreferencesView` in its own window instead.
export component NotificationsDemoWindow inherits Window {
    in-out property <bool> rtl <=> AedstLayout.rtl;
    in-out property <bool> dark <=> AedstTokens.dark;
    in-out property <string> screen: "inbox"; // inbox | preferences
    title: @tr("" => "Notifications");
    background: AedstTokens.background;
    min-width: 640px;
    min-height: 560px;
    preferred-width: 640px;
    preferred-height: 560px;

    VerticalLayout {
        if root.screen == "inbox": NotificationsListView {}
        if root.screen == "preferences": NotificationPreferencesView {}
    }
}
