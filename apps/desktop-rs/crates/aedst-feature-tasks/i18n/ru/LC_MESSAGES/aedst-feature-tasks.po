msgid "You are offline. Changes will sync later."
msgstr "Вы не в сети. Изменения синхронизируются позже."

msgid "The server is not available right now."
msgstr "Сервер сейчас недоступен."

msgid "The request took too long."
msgstr "Запрос выполнялся слишком долго."

msgid "Too many requests. Try again in a moment."
msgstr "Слишком много запросов. Повторите чуть позже."

msgid "Please sign in again."
msgstr "Войдите снова."

msgid "You do not have access to this."
msgstr "У вас нет доступа к этому."

msgid "This task no longer exists."
msgstr "Эта задача больше не существует."

msgid "The server did not accept this input."
msgstr "Сервер не принял эти данные."

msgid "This task was changed elsewhere."
msgstr "Эта задача была изменена в другом месте."

msgid "Please update the app to continue."
msgstr "Обновите приложение, чтобы продолжить."

msgid "Could not save on this device."
msgstr "Не удалось сохранить на этом устройстве."

msgid "Something went wrong."
msgstr "Что-то пошло не так."

msgid "Enter a title."
msgstr "Введите название."

msgid "The title is too long (200 characters at most)."
msgstr "Название слишком длинное (не более 200 символов)."

msgid "The description is too long."
msgstr "Описание слишком длинное."

msgid "Choose a priority."
msgstr "Выберите приоритет."

msgid "To do"
msgstr "К выполнению"

msgid "In progress"
msgstr "В работе"

msgid "Done"
msgstr "Готово"

msgid "Unknown"
msgstr "Неизвестно"

msgid "Low"
msgstr "Низкий"

msgid "Medium"
msgstr "Средний"

msgid "High"
msgstr "Высокий"

msgid "Urgent"
msgstr "Срочный"

msgid "Tasks"
msgstr "Задачи"

msgid "{} in total"
msgstr "Всего: {}"

msgid "Waiting to sync: {}"
msgstr "Ожидает синхронизации: {}"

msgid "New task title"
msgstr "Название новой задачи"

msgid "What needs to be done?"
msgstr "Что нужно сделать?"

msgid "Adding..."
msgstr "Добавление..."

msgid "Add task"
msgstr "Добавить задачу"

msgid "Loading..."
msgstr "Загрузка..."

msgid "Could not load tasks"
msgstr "Не удалось загрузить задачи"

msgid "Try again"
msgstr "Повторить"

msgid "No tasks yet"
msgstr "Задач пока нет"

msgid "Add your first task above."
msgstr "Добавьте первую задачу выше."

msgid "Mark \"{}\" as done"
msgstr "Отметить «{}» выполненной"

msgid "Pending sync"
msgstr "Ждёт синхронизации"

msgid "Load more"
msgstr "Загрузить ещё"
