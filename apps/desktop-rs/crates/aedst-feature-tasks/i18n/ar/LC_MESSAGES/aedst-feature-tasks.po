msgid "You are offline. Changes will sync later."
msgstr "أنت غير متصل. ستتم مزامنة التغييرات لاحقًا."

msgid "The server is not available right now."
msgstr "الخادم غير متاح حاليًا."

msgid "The request took too long."
msgstr "استغرق الطلب وقتًا طويلًا."

msgid "Too many requests. Try again in a moment."
msgstr "طلبات كثيرة جدًا. حاول مرة أخرى بعد قليل."

msgid "Please sign in again."
msgstr "يرجى تسجيل الدخول مرة أخرى."

msgid "You do not have access to this."
msgstr "ليس لديك صلاحية الوصول إلى هذا."

msgid "This task no longer exists."
msgstr "هذه المهمة لم تعد موجودة."

msgid "The server did not accept this input."
msgstr "لم يقبل الخادم هذا الإدخال."

msgid "This task was changed elsewhere."
msgstr "تم تغيير هذه المهمة في مكان آخر."

msgid "Please update the app to continue."
msgstr "يرجى تحديث التطبيق للمتابعة."

msgid "Could not save on this device."
msgstr "تعذر الحفظ على هذا الجهاز."

msgid "Something went wrong."
msgstr "حدث خطأ ما."

msgid "Enter a title."
msgstr "أدخل عنوانًا."

msgid "The title is too long (200 characters at most)."
msgstr "العنوان طويل جدًا (200 حرف كحد أقصى)."

msgid "The description is too long."
msgstr "الوصف طويل جدًا."

msgid "Choose a priority."
msgstr "اختر الأولوية."

msgid "To do"
msgstr "للتنفيذ"

msgid "In progress"
msgstr "قيد التنفيذ"

msgid "Done"
msgstr "منجز"

msgid "Unknown"
msgstr "غير معروف"

msgid "Low"
msgstr "منخفضة"

msgid "Medium"
msgstr "متوسطة"

msgid "High"
msgstr "عالية"

msgid "Urgent"
msgstr "عاجلة"

msgid "Tasks"
msgstr "المهام"

msgid "{} in total"
msgstr "الإجمالي: {}"

msgid "Waiting to sync: {}"
msgstr "بانتظار المزامنة: {}"

msgid "New task title"
msgstr "عنوان المهمة الجديدة"

msgid "What needs to be done?"
msgstr "ما الذي يجب إنجازه؟"

msgid "Adding..."
msgstr "جارٍ الإضافة..."

msgid "Add task"
msgstr "إضافة مهمة"

msgid "Loading..."
msgstr "جارٍ التحميل..."

msgid "Could not load tasks"
msgstr "تعذر تحميل المهام"

msgid "Try again"
msgstr "حاول مرة أخرى"

msgid "No tasks yet"
msgstr "لا توجد مهام بعد"

msgid "Add your first task above."
msgstr "أضف مهمتك الأولى أعلاه."

msgid "Mark \"{}\" as done"
msgstr "وضع علامة «{}» كمنجزة"

msgid "Pending sync"
msgstr "بانتظار المزامنة"

msgid "Load more"
msgstr "تحميل المزيد"
