{
  "name": "@aedst/web-marketing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "prebuild": "node ../shared/scripts/check-seo-placeholders.mjs",
    "build": "next build && node scripts/build-security-headers.mjs",
    "start": "node scripts/serve-out.mjs --port 3002",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knip": "knip",
    "check:bundle": "node ../shared/scripts/check-bundle-size.mjs",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "check:deps": "depcruise src ../shared --config .dependency-cruiser.cjs",
    "check:source": "node ../shared/scripts/check-source-bans.mjs",
    "check:seo": "cross-env AEDST_REQUIRE_REAL_SEO=1 node ../shared/scripts/check-seo-placeholders.mjs",
    "check:seo:live": "node ../shared/scripts/check-seo-live.mjs --base http://127.0.0.1:3002",
    "check:dates": "node scripts/check-dates.mjs",
    "check:selftest": "node ../app/scripts/check-selftest.mjs",
    "check:feature-boundaries": "bash ../app/scripts/check-feature-boundaries.sh .",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm check:file-size && pnpm check:colors && pnpm check:forms && pnpm check:validation && pnpm check:deps && pnpm check:feature-boundaries && pnpm check:source && pnpm check:dates && pnpm check:selftest",
    "check:file-size": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-file-size.mjs",
    "check:colors": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-color-literals.mjs",
    "check:forms": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-forms.mjs",
    "check:validation": "node ../app/scripts/check-validation.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "catalog:",
    "@fontsource/ibm-plex-sans-arabic": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "next-intl": "catalog:",
    "cn": "catalog:",
    "@hugeicons/react": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@sentry/nextjs": "catalog:",
    "zod": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "vitest": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "knip": "catalog:",
    "dependency-cruiser": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "@playwright/test": "catalog:",
    "@axe-core/playwright": "catalog:",
    "shadcn": "catalog:",
    "cross-env": "catalog:"
  }
}
