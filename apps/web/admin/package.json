{
  "name": "@aedst/web-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs --vite",
    "dev:spa": "vite",
    "dev:server": "node server/dev.mjs",
    "build": "vite build",
    "build:server": "node server/build.mjs",
    "build:all": "pnpm build && pnpm build:server",
    "start": "node dist-server/main.mjs",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit && pnpm typecheck:server",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test": "vitest run && pnpm test:server",
    "test:server": "vitest run --config vitest.server.config.mts",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "knip": "knip",
    "check:bundle": "node ../shared/scripts/check-bundle-size.mjs",
    "check:source": "node ../shared/scripts/check-source-bans.mjs",
    "check:feature-boundaries": "bash ../app/scripts/check-feature-boundaries.sh .",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm check:file-size && pnpm check:colors && pnpm check:forms && pnpm check:validation && pnpm check:feature-boundaries && pnpm check:source && pnpm check:selftest",
    "preview": "vite preview",
    "check:file-size": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-file-size.mjs",
    "check:colors": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-color-literals.mjs",
    "check:forms": "cross-env AEDST_WEB_ROOT=. node ../app/scripts/check-forms.mjs",
    "check:validation": "node ../app/scripts/check-validation.mjs",
    "check:selftest": "node ../app/scripts/check-selftest.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-query": "catalog:",
    "@fontsource/ibm-plex-sans-arabic": "catalog:",
    "@fontsource/noto-sans": "catalog:",
    "@hono/node-server": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@sentry/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "cn": "catalog:",
    "hono": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:",
    "use-intl": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@babel/core": "catalog:",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
