{
  // The pnpm catalog lives one level up (apps/web/pnpm-workspace.yaml), where knip does not look.
  "rules": { "catalogReferences": "off" },
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Entry points knip cannot discover on its own. index.html -> src/main.tsx,
  // vite.config.ts and the vitest config are auto-detected by plugins.
  "entry": [
    // The BFF (Hono): bundled by server/build.mjs, tested by vitest.server.config.mts.
    "server/main.ts",
    "server/*.mjs",
    // Aliased in place of `server-only` by the bundler and vitest, not imported.
    "server/stubs/server-only.ts",
    // Route files are imported by the generated route tree (src/app/routeTree.gen.ts).
    "src/app/routes/**/*.tsx",
    // use-intl `AppConfig` type augmentation, picked up by tsc, never imported.
    "src/app/config/i18n/messages-types.ts",
    // Aliased in place of `server-only` by vitest.config.mts, not imported.
    "src/test/mocks/empty-module.ts",
    // A module's full public surface; routes import the single-export entries/ files.
    "src/modules/*/public.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "server/**/*.ts"],
  "ignore": [
    // The source-only kit is checked by the project that hosts it (apps/web/app).
    // Generated by @tanstack/router-plugin on every dev/build run.
    "src/app/routeTree.gen.ts"
  ],
  "ignoreIssues": {
    // Mock helpers kept complete for the next test that needs them.
    // Same exports as next-intl's createNavigation, kept for the shared kit's contract.
    "src/app/i18n/navigation.tsx": ["exports"],
    "src/test/render.tsx": ["exports"]
  },
  // Approved-stack libraries referenced only from CSS or CLI config, which knip does not follow.
  "ignoreDependencies": [
    "shadcn",
    "tw-animate-css",
    "tailwindcss",
    // Fonts imported from globals.css.
    "@fontsource/noto-sans",
    "@fontsource/ibm-plex-sans-arabic",
    // Peer of the shared kit, resolved from ../shared.
    "@hugeicons/core-free-icons"
  ]
}
