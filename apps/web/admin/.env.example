# Admin panel (apps/web/admin), port 3001. A SEPARATE OIDC client and session from
# apps/web/app: own client id, own cookies, no shared session (see docs/content/web/projects.md).

# --- Public: inlined into the browser bundle at build time. No secrets. ---

# Canonical origin of THIS project (https:// in every deployed environment,
# which also turns on the `__Host-` prefix and Secure flag of session cookies).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Origin of the product app project (apps/web/app): used only for the "back to app"
# link on /forbidden. Admin signs in on its own origin, never on the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Empty locally. Set in staging/production only; also derives the CSP report-uri.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# --- Server-only: never sent to the browser. ---

# apps/server ConnectRPC address (the browser only calls this origin's /api/rpc).
API_BASE_URL=http://localhost:8080

XX
AUTH_COOKIE_NAME=aedst_admin_session

# Where roles live in the access token; must match apps/server's
# AEDST_OIDC_ROLES_CLAIM (and apps/web/app's AUTH_ROLES_CLAIM).
AUTH_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
AUTH_ROLES_ORG=

# Admin's OWN OIDC client at the shared IdP (ZITADEL SSO makes sign-in seamless).
# Redirect URI: ${ADMIN_ORIGIN}/api/auth/callback (e.g. http://localhost:3001/api/auth/callback)
# Post-logout URI: ${ADMIN_ORIGIN} (e.g. http://localhost:3001). Used by /api/auth/login,
# /api/auth/callback, sign-out, and the refresh in proxy.ts and /api/rpc. Read lazily.
OIDC_ISSUER=http://localhost:8085
OIDC_CLIENT_ID=aedst-admin
OIDC_CLIENT_SECRET=
OIDC_PROJECT_ID=
OIDC_SCOPE=
# Seals the pre-auth cookie; 32+ chars, required in production, shared by admin replicas only.
OIDC_STATE_SECRET=

# Build-time only (Sentry source-map upload, read by next.config.ts).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=
