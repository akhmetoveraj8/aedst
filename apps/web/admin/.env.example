# Admin panel (apps/web/admin), a Vite SPA on port 3001 behind a Hono BFF. A SEPARATE OIDC
# client and session from apps/web/app: own client id, own cookies, no shared session
# (see docs/content/web/projects.md).

# --- Browser (Vite): VITE_* is inlined into the static bundle at build time. No secrets. ---

# Canonical origin of THIS project (https:// in every deployed environment).
VITE_SITE_URL=http://localhost:3001

# Origin of the product app project (apps/web/app): used only for the "back to app"
# link on /forbidden. Admin signs in on its own origin, never on the app.
VITE_APP_URL=http://localhost:3000

# Empty locally. Set in staging/production only.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_TRACES_SAMPLE_RATE=

# --- Dev server / build only (read by vite.config.ts, never shipped) ---

# Where `vite` proxies /api/** in dev (the BFF).
ADMIN_BFF_URL=http://localhost:3101

# Source-map upload to Sentry during `vite build` (skipped without a token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_RELEASE=

# --- BFF (apps/web/admin/server) variables are documented and read there, not here. ---
# The SPA never sees tokens, cookie names, OIDC settings or API_BASE_URL.
