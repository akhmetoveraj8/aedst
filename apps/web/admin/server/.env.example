# Admin BFF (apps/web/admin/server): runtime variables, validated in server/env.ts.
# The browser bundle's VITE_* variables are in ../.env.example. Dev: copy to
# ../.env.local (dev.mjs loads it); in containers set them on the container.

# Browser-visible origin of the panel (no path). REQUIRED in production; the
# OIDC redirect URI is ${ADMIN_ORIGIN}/api/auth/callback. An https origin turns
# on Secure cookies with the __Host- prefix.
ADMIN_ORIGIN=http://localhost:3001

# Listening port: ADMIN_BFF_PORT, else PORT, else 3101 (the Vite dev proxy target).
ADMIN_BFF_PORT=3101

# Vite build output served by the BFF (default: ../dist next to dist-server/).
# ADMIN_STATIC_DIR=

# Server-to-server address of apps/server (never reaches the browser).
API_BASE_URL=http://localhost:8080

# Own cookies, never shared with apps/web/app (aedst_session).
AUTH_COOKIE_NAME=aedst_admin_session
# Where the roles live in the access token (read by shared/lib/auth).
# AUTH_ROLES_CLAIM=urn:zitadel:iam:org:project:roles
# AUTH_ROLES_ORG=

# OpenID Connect: the admin is its own client. ISSUER, CLIENT_ID and
# STATE_SECRET (32+ chars, shared by all replicas) are required in production.
OIDC_ISSUER=http://localhost:8085
OIDC_CLIENT_ID=aedst-admin
# OIDC_CLIENT_SECRET=
# OIDC_PROJECT_ID=
# OIDC_SCOPE=
# OIDC_STATE_SECRET=

# DSN of the browser Sentry project: derives the CSP report URI and the ingest
# origin allowed in connect-src. Not a secret. Empty = both off.
# SENTRY_DSN=

# Trust X-Forwarded-For for logs; only behind a proxy that overwrites it.
# TRUST_PROXY=false
# LOG_LEVEL=info
