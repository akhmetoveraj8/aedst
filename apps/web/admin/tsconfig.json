{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["vite/client", "node"],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/shared/i18n/navigation": ["./src/app/i18n/navigation.tsx"],
      "@/shared/*": ["../shared/*"],
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@sentry/nextjs": ["./node_modules/@sentry/react"]
    }
  },
  "include": ["src", "e2e", "*.ts", "*.mts", "../shared/env/process-env.d.ts"],
  "exclude": ["node_modules", "dist", "server"]
}
