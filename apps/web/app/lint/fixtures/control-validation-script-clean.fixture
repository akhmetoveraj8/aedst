import { useForm } from "react-hook-form";
import { protovalidateResolver } from "@/shared/lib/forms/protovalidate-resolver";

const resolver = protovalidateResolver;

export function OkForm() {
  const form = useForm<{ title: string }>({ resolver, defaultValues: { title: "" } });
  return form.getValues("title");
}
