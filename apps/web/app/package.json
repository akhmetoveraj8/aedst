{
  "name": "@aedst/web-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node ../shared/scripts/check-seo-placeholders.mjs",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:browser:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:prod": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 next build && cross-env CI=1 playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm check:file-size && pnpm check:colors && pnpm check:forms && pnpm check:validation && pnpm check:feature-boundaries && pnpm check:source && pnpm check:selftest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:stories": "vitest run --config vitest.storybook.config.mts",
    "test:stories:rtl-dark": "cross-env STORYBOOK_DIRECTION=rtl STORYBOOK_THEME=dark vitest run --config vitest.storybook.config.mts",
    "test:visual": "cross-env STORYBOOK_VISUAL=1 vitest run --config vitest.storybook.config.mts",
    "test:visual:update": "cross-env STORYBOOK_VISUAL=1 vitest run --config vitest.storybook.config.mts --update",
    "check:bundle": "node ../shared/scripts/check-bundle-size.mjs",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:colors": "node scripts/check-color-literals.mjs",
    "check:seo": "cross-env AEDST_REQUIRE_REAL_SEO=1 node ../shared/scripts/check-seo-placeholders.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:validation": "node scripts/check-validation.mjs",
    "check:selftest": "node scripts/check-selftest.mjs",
    "lighthouse:signed-in": "node scripts/lighthouse-signed-in.mjs",
    "lighthouse": "cross-env NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 pnpm dlx @lhci/cli@0.15.1 autorun",
    "connect:generate": "node scripts/connect-generate.mjs",
    "knip": "knip",
    "check:source": "node ../shared/scripts/check-source-bans.mjs",
    "check:feature-boundaries": "bash scripts/check-feature-boundaries.sh",
    "test:contract": "vitest run src/test/contract",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@connectrpc/connect": "catalog:",
    "@connectrpc/connect-query": "catalog:",
    "@connectrpc/connect-web": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@sentry/nextjs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "client-only": "catalog:",
    "cn": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "nuqs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "zustand": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@serwist/turbopack": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "serwist": "catalog:",
    "sonner": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@biomejs/biome": "catalog:",
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@playwright/test": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query-devtools": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "axe-core": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "cross-env": "catalog:",
    "esbuild": "catalog:",
    "knip": "catalog:",
    "shadcn": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ]
}
