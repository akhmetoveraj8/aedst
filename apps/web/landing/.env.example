# Landing project (apps/web/landing). NEXT_PUBLIC_* values are inlined at build time.

# Canonical public origin of THIS site (canonical, sitemap, JSON-LD, llms.txt, OG).
# Must be the real https origin in every deployed environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Origin of the signed-in product app (apps/web/app). CTA buttons link here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional search-console ownership tokens (token value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
