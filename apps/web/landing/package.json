    "@hugeicons/react": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@sentry/nextjs": "catalog:",
    "zod": "catalog:",
    "tw-animate-css": "catalog:",
    "shadcn": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
