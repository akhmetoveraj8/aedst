            "value" : "Продолжить"
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идома додан"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Davom etish"
          }
        }
