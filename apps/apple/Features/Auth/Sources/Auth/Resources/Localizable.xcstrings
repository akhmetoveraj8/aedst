    "authBrowserSignInFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إكمال تسجيل الدخول. يرجى المحاولة مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in could not be completed. Please try again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось выполнить вход. Попробуйте ещё раз."
          }
        },
        "tg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Воридшавӣ анҷом дода нашуд. Лутфан, бори дигар кӯшиш кунед."
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirishni yakunlab bo'lmadi. Qaytadan urinib ko'ring."
          }
        }
      }
    },
    "authLoginContinue" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متابعة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        },
        "ru" : {
          "stringUnit" : {
