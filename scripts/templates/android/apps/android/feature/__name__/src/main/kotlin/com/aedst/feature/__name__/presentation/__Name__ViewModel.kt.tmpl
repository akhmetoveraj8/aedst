package com.aedst.feature.{{name}}.presentation

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.aedst.core.common.Outcome
import com.aedst.feature.{{name}}.domain.{{Name}}Entry
import com.aedst.feature.{{name}}.domain.{{Name}}Repository
import dev.zacsweers.metro.AppScope
import dev.zacsweers.metro.ContributesIntoMap
import dev.zacsweers.metro.Inject
import dev.zacsweers.metrox.viewmodel.ViewModelKey
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch

data class {{Name}}State(val isLoading: Boolean = true, val entries: List<{{Name}}Entry> = emptyList())

@ViewModelKey
@ContributesIntoMap(AppScope::class)
class {{Name}}ViewModel @Inject constructor(private val repository: {{Name}}Repository) : ViewModel() {

    private val mutableState = MutableStateFlow({{Name}}State())
    val state: StateFlow<{{Name}}State> = mutableState.asStateFlow()

    init {
        viewModelScope.launch {
            val entries = (repository.entries() as? Outcome.Success)?.value.orEmpty()
